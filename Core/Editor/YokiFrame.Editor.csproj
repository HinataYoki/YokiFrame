<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>YokiFrame.Editor</AssemblyName>
    <RootNamespace>YokiFrame</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);GODOT;TOOLS</DefineConstants>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**/*.cs"
             Exclude="Adapters/**/*.cs;**/Tests/**/*.cs;bin/**/*.cs;obj/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Runtime/YokiFrame.csproj">
      <AdditionalProperties>YokiFrameToolsBuild=True</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <!--
    Runtime manifest 校验器已收敛到本共享程序集，Godot 工具构建需要 System.Text.Json。
    Unity 由 asmdef 决定程序集引用，此 PackageReference 不进入 Unity 编译。
  -->
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
</Project>
