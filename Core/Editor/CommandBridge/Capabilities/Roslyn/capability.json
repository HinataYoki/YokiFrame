    "verifyRecipes": [
      {
        "id": "engine-script",
        "description": "Check script_status, submit trusted C# in memory, then observe run_result. Acceptance and compilation are not a passing run.",
        "gates": ["runtime-response-success", "engine-identity-current", "context-payload-valid"],
        "evidence": ["command-response", "run-record", "run-result"]
      },
      {
        "id": "engine-domain-state",
        "description": "Read the hosting engine state (mode, active target, play/compile status, switch state) without mutating editor state.",
        "gates": [
          "runtime-response-success",
          "engine-identity-current",
          "context-payload-valid"
        ],
        "evidence": [
          "command-response",
          "snapshot"
        ]
      },
      {
        "id": "engine-capabilities",
        "description": "Read the RoslynKit operation x target availability matrix together with the execution switch state and reason.",
        "gates": [
          "runtime-response-success",
          "engine-identity-current"
        ],
        "evidence": [
          "command-response"
        ]
      },
      {
        "id": "engine-play-control",
        "description": "Request a play mode transition and then re-read domain_state; the response only reports acceptance, never the outcome.",
        "gates": [
          "runtime-response-success",
          "engine-identity-current",
          "context-payload-valid"
        ],
        "evidence": [
          "command-response",
          "snapshot"
        ]
      },
      {
        "id": "engine-scene-query",
        "description": "Read the active scene hierarchy within the documented bounds; truncated=true means the returned tree is partial.",
        "gates": [
          "runtime-response-success",
          "engine-identity-current",
          "context-payload-valid"
        ],
        "evidence": [
          "command-response"
        ]
      },
      {
        "id": "engine-object-discovery",
        "description": "Discover initialized live services and public member metadata for the active target. No getters, methods, attributes, enumerators or lazy initialization are executed; verify paging, limits and handle invalidation.",
        "gates": [
          "runtime-response-success",
          "engine-identity-current"
        ],
        "evidence": [
          "command-response",
          "snapshot"
        ]
      },
      {
        "id": "engine-scene-mutate",
        "description": "Mutate one scene object with Undo registered and the scene marked dirty; play mode reports undo as unavailable instead of pretending.",
        "gates": [
          "runtime-response-success",
          "engine-identity-current",
          "context-payload-valid"
        ],
        "evidence": [
          "command-response",
          "scene-snapshot"
        ]
      },
      {
        "id": "engine-asset-ops",
        "description": "Refresh/import/find/inspect assets; refused while Unity is compiling or importing.",
        "gates": [
          "runtime-response-success",
          "engine-identity-current",
          "context-payload-valid"
        ],
        "evidence": [
          "command-response"
        ]
      },
      {
        "id": "engine-eval",
        "description": "Godot-only inline GDScript eval. No generated C# or domain reload. eval_result only reads stored results.",
        "gates": [
          "runtime-response-success",
          "engine-identity-current",
          "context-payload-valid"
        ],
        "evidence": [
          "command-response",
          "eval-record"
        ]
      }
