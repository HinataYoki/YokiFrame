<Project Sdk="Microsoft.NET.Sdk">

  <!--
    这些目录的全部源文件都有 YOKIFRAME_TOOLING 整文件守卫。
    目录通配让同目录新增或改名自动进入工具链，避免逐文件链接在布局调整后失效。
  -->
  <ItemGroup>
    <Compile Include="..\..\..\Core\Editor\CommandBridge\Protocol\**\*.cs" Link="EditorContracts\CommandBridge\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\Core\Editor\CommandBridge\FastChannel\Transport\**\*.cs" Link="EditorSupport\FastChannel\Transport\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\Core\Editor\CommandBridge\FastChannel\Queue\**\*.cs" Link="EditorSupport\FastChannel\Queue\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\Core\Editor\Telemetry\SharedMemory\**\*.cs" Link="EditorContracts\Telemetry\SharedMemory\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\Core\Editor\Telemetry\Identity\**\*.cs" Link="EditorContracts\Telemetry\Identity\%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);YOKIFRAME_TOOLING</DefineConstants>
  </PropertyGroup>

</Project>
