<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\YokiFrame.Client\YokiFrame.Client.csproj" />
    <ProjectReference Include="..\YokiFrame.Protocol\YokiFrame.Protocol.csproj" />
    <ProjectReference Include="..\YokiFrame.Tooling.Application\YokiFrame.Tooling.Application.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Native AOT 只在可执行入口映射，避免全局属性传播到 netstandard 项目引用。 -->
    <PublishAot Condition="'$(YokiFramePublishAot)' == 'true'">true</PublishAot>
  </PropertyGroup>

</Project>
