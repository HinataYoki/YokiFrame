<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             xmlns:shapes="using:Avalonia.Controls.Shapes"
             xmlns:vm="using:YokiFrame.Workbench.Avalonia.ViewModels"
             x:Class="YokiFrame.Workbench.Avalonia.Components.AppTitleBar"
             x:DataType="vm:WorkbenchShellViewModel">
  <Grid ColumnDefinitions="224,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
        ColumnSpacing="8"
        Margin="16,8,18,8">
    <Border Grid.Column="1"
            Background="Transparent"
            chrome:WindowDecorationProperties.ElementRole="TitleBar" />
    <TextBlock Grid.Column="2"
               Text="{CompiledBinding RuntimeUpdate.StatusText}"
               IsVisible="{CompiledBinding RuntimeUpdate.IsStatusVisible}"
               Classes="muted"
               FontSize="{DynamicResource FontSize.Sm}"
               MaxWidth="220"
               TextTrimming="CharacterEllipsis"
               ToolTip.Tip="{CompiledBinding RuntimeUpdate.StatusText}"
               AutomationProperties.LiveSetting="Polite"
               VerticalAlignment="Center"
               chrome:WindowDecorationProperties.ElementRole="User" />
    <Grid Grid.Column="3"
          RowDefinitions="Auto,Auto"
          VerticalAlignment="Center"
          chrome:WindowDecorationProperties.ElementRole="User">
      <Button Command="{CompiledBinding RuntimeUpdate.RebuildCommand}"
              IsVisible="{CompiledBinding RuntimeUpdate.IsVisible}"
              Classes="primary compact-action"
              ToolTip.Tip="检测到新版源码，点击构建新的 Workbench Runtime"
              AutomationProperties.Name="有新版可编译">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <shapes:Path Data="{StaticResource Icon.Download}"
                       Width="13"
                       Height="13"
                       Fill="Transparent"
                       Stroke="White"
                       StrokeThickness="1.75"
                       StrokeLineCap="Round"
                       StrokeJoin="Round"
                       Stretch="Uniform" />
          <TextBlock Text="{CompiledBinding RuntimeUpdate.ButtonText}" />
        </StackPanel>
      </Button>
      <ProgressBar Grid.Row="1"
                   Classes="runtime-update-progress"
                   Margin="0,3,0,0"
                   IsVisible="{CompiledBinding RuntimeUpdate.IsBuilding}"
                   IsIndeterminate="True" />
    </Grid>
    <Border Grid.Column="4"
            Classes="badge"
            VerticalAlignment="Center"
            chrome:WindowDecorationProperties.ElementRole="User">
      <TextBlock Text="{CompiledBinding ConnectionBadgeText}"
                 Foreground="{DynamicResource Brush.Status.SuccessText}"
                 FontSize="{DynamicResource FontSize.Sm}"
                 FontWeight="SemiBold" />
    </Border>
    <Button Grid.Column="5"
            Classes="secondary icon-button chrome-button"
            Click="OnToggleThemeButtonClick"
            ToolTip.Tip="切换主题"
            VerticalAlignment="Center"
            chrome:WindowDecorationProperties.ElementRole="User">
      <Grid Width="16"
            Height="16">
        <shapes:Path x:Name="ThemeSunIcon"
                     Data="{StaticResource Icon.Sun}"
                     Width="16"
                     Height="16"
                     Fill="Transparent"
                     Stroke="{DynamicResource Brush.Text.Primary}"
                     StrokeThickness="1.75"
                     StrokeLineCap="Round"
                     StrokeJoin="Round"
                     Stretch="Uniform" />
        <shapes:Path x:Name="ThemeMoonIcon"
                     Data="{StaticResource Icon.Moon}"
                     Width="16"
                     Height="16"
                     Fill="Transparent"
                     Stroke="{DynamicResource Brush.Text.Primary}"
                     StrokeThickness="1.75"
                     StrokeLineCap="Round"
                     StrokeJoin="Round"
                     Stretch="Uniform"
                     IsVisible="False" />
      </Grid>
    </Button>
    <ComboBox Grid.Column="6"
              Classes="titlebar-select"
              SelectedItem="{CompiledBinding CultureText}"
              ItemsSource="{CompiledBinding CultureOptions}"
              Width="92"
              VerticalAlignment="Center"
              chrome:WindowDecorationProperties.ElementRole="User" />
    <Button Grid.Column="7"
            Classes="secondary icon-button chrome-button"
            Click="OnMaximizeWindowButtonClick"
            ToolTip.Tip="最大化"
            VerticalAlignment="Center"
            chrome:WindowDecorationProperties.ElementRole="MaximizeButton">
      <shapes:Path Data="{StaticResource Icon.Maximize}"
                   Width="16"
                   Height="16"
                   Fill="Transparent"
                   Stroke="{DynamicResource Brush.Text.Primary}"
                   StrokeThickness="1.75"
                   StrokeLineCap="Round"
                   StrokeJoin="Round"
                   Stretch="Uniform" />
    </Button>
    <Button Grid.Column="8"
            Classes="secondary icon-button chrome-button close-button"
            Click="OnCloseWindowButtonClick"
            ToolTip.Tip="关闭"
            VerticalAlignment="Center"
            chrome:WindowDecorationProperties.ElementRole="CloseButton">
      <shapes:Path Data="{StaticResource Icon.Close}"
                   Width="16"
                   Height="16"
                   Fill="Transparent"
                   Stroke="{DynamicResource Brush.Text.Primary}"
                   StrokeThickness="1.75"
                   StrokeLineCap="Round"
                   StrokeJoin="Round"
                   Stretch="Uniform" />
    </Button>
  </Grid>
</UserControl>
