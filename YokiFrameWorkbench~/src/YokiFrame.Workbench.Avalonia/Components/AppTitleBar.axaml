<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             xmlns:shapes="using:Avalonia.Controls.Shapes"
             xmlns:vm="using:YokiFrame.Workbench.Avalonia.ViewModels"
             x:Class="YokiFrame.Workbench.Avalonia.Components.AppTitleBar"
             x:DataType="vm:WorkbenchShellViewModel">
  <Grid ColumnDefinitions="224,*,Auto,Auto,Auto,Auto,Auto"
        ColumnSpacing="8"
        Margin="16,8,18,8">
    <Border Grid.Column="1"
            Background="Transparent"
            chrome:WindowDecorationProperties.ElementRole="TitleBar" />
    <Border Grid.Column="2"
            Classes="badge"
            VerticalAlignment="Center"
            chrome:WindowDecorationProperties.ElementRole="User">
      <TextBlock Text="{CompiledBinding ConnectionBadgeText}"
                 Foreground="{DynamicResource Brush.Status.SuccessText}"
                 FontSize="{DynamicResource FontSize.Sm}"
                 FontWeight="SemiBold" />
    </Border>
    <Button Grid.Column="3"
            Classes="secondary icon-button chrome-button"
            Click="OnToggleThemeButtonClick"
            ToolTip.Tip="切换主题"
            VerticalAlignment="Center"
            chrome:WindowDecorationProperties.ElementRole="User">
      <Grid Width="16"
            Height="16">
        <shapes:Path x:Name="ThemeSunIcon"
                     Data="{StaticResource Icon.Sun}"
                     Width="16"
                     Height="16"
                     Fill="Transparent"
                     Stroke="{DynamicResource Brush.Text.Primary}"
                     StrokeThickness="1.75"
                     StrokeLineCap="Round"
                     StrokeJoin="Round"
                     Stretch="Uniform" />
        <shapes:Path x:Name="ThemeMoonIcon"
                     Data="{StaticResource Icon.Moon}"
                     Width="16"
                     Height="16"
                     Fill="Transparent"
                     Stroke="{DynamicResource Brush.Text.Primary}"
                     StrokeThickness="1.75"
                     StrokeLineCap="Round"
                     StrokeJoin="Round"
                     Stretch="Uniform"
                     IsVisible="False" />
      </Grid>
    </Button>
    <ComboBox Grid.Column="4"
              Classes="titlebar-select"
              SelectedItem="{CompiledBinding CultureText}"
              ItemsSource="{CompiledBinding CultureOptions}"
              Width="92"
              VerticalAlignment="Center"
              chrome:WindowDecorationProperties.ElementRole="User" />
    <Button Grid.Column="5"
            Classes="secondary icon-button chrome-button"
            Click="OnMaximizeWindowButtonClick"
            ToolTip.Tip="最大化"
            VerticalAlignment="Center"
            chrome:WindowDecorationProperties.ElementRole="MaximizeButton">
      <shapes:Path Data="{StaticResource Icon.Maximize}"
                   Width="16"
                   Height="16"
                   Fill="Transparent"
                   Stroke="{DynamicResource Brush.Text.Primary}"
                   StrokeThickness="1.75"
                   StrokeLineCap="Round"
                   StrokeJoin="Round"
                   Stretch="Uniform" />
    </Button>
    <Button Grid.Column="6"
            Classes="secondary icon-button chrome-button close-button"
            Click="OnCloseWindowButtonClick"
            ToolTip.Tip="关闭"
            VerticalAlignment="Center"
            chrome:WindowDecorationProperties.ElementRole="CloseButton">
      <shapes:Path Data="{StaticResource Icon.Close}"
                   Width="16"
                   Height="16"
                   Fill="Transparent"
                   Stroke="{DynamicResource Brush.Text.Primary}"
                   StrokeThickness="1.75"
                   StrokeLineCap="Round"
                   StrokeJoin="Round"
                   Stretch="Uniform" />
    </Button>
  </Grid>
</UserControl>
