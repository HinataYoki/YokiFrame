<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokiFrame.Workbench.Avalonia.ViewModels"
             x:Class="YokiFrame.Workbench.Avalonia.Components.MetricCard"
             x:DataType="vm:WorkbenchMetricCard">
  <Border Classes="card metric-card"
          Padding="8,6"
          Classes.positive="{CompiledBinding IsPositive}"
          Classes.accent="{CompiledBinding IsAccent}"
          ToolTip.Tip="{CompiledBinding Detail}">
    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="2">
      <TextBlock Text="{CompiledBinding Title}"
                 Classes="muted"
                 FontSize="{DynamicResource FontSize.Sm}"
                 FontWeight="SemiBold"
                 MaxLines="1"
                 TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{CompiledBinding Title}" />
      <TextBlock Grid.Row="1"
                 Text="{CompiledBinding Value}"
                 Classes="mono"
                 FontSize="{DynamicResource FontSize.Lg}"
                 FontWeight="SemiBold"
                 MaxLines="1"
                 TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{CompiledBinding Value}" />
      <TextBlock Grid.Row="2"
                 Text="{CompiledBinding Detail}"
                 Classes="muted"
                 FontSize="{DynamicResource FontSize.Sm}"
                 MaxLines="1"
                 TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{CompiledBinding Detail}" />
    </Grid>
  </Border>
</UserControl>
