  <!-- 页面标题与功能描述 -->
  <x:String x:Key="String.Page.Framework.Title">框架总览</x:String>
  <x:String x:Key="String.Page.Framework.Description">查看框架连接、引擎通信、AI Skills 与运行日志。</x:String>
  <x:String x:Key="String.Page.Doctor.Title">诊断</x:String>
  <x:String x:Key="String.Page.Doctor.Description">检查宿主通信、协议状态与可操作诊断。</x:String>
  <x:String x:Key="String.Page.Docs.Title">文档</x:String>
  <x:String x:Key="String.Page.Docs.Description">浏览随 YokiFrame 包提供的离线文档与 API 参考。</x:String>
  <x:String x:Key="String.Page.EventKit.Title">EventKit</x:String>
  <x:String x:Key="String.Page.EventKit.Description">观察 Runtime 事件、活动监听与近期发送时间线。</x:String>
  <x:String x:Key="String.Page.FsmKit.Title">FsmKit</x:String>
  <x:String x:Key="String.Page.FsmKit.Description">观察状态机实例、当前状态、转换历史与运行证据。</x:String>
  <x:String x:Key="String.Page.LogKit.Title">LogKit</x:String>
  <x:String x:Key="String.Page.LogKit.Description">配置 Runtime 日志输出、等级、容量与文件策略。</x:String>
  <x:String x:Key="String.Page.PoolKit.Title">PoolKit 对象池监视</x:String>
  <x:String x:Key="String.Page.PoolKit.Description">对象池列表、借出对象、峰值和泄漏候选集中展示。</x:String>
  <x:String x:Key="String.Page.ResKit.Title">ResKit 资源工作台</x:String>
  <x:String x:Key="String.Page.ResKit.Description">观察 Provider、已加载资源、lease 来源与卸载历史。</x:String>
  <x:String x:Key="String.Page.ActionKit.Title">ActionKit 动作调度</x:String>
  <x:String x:Key="String.Page.ActionKit.Description">观察活动动作树、生命周期终态与按需调用堆栈。</x:String>
  <x:String x:Key="String.Page.AudioKit.Title">AudioKit 观察器</x:String>
  <x:String x:Key="String.Page.AudioKit.Description">按 Bus 观察当前播放、进度与播放历史。</x:String>
  <x:String x:Key="String.Page.SpatialKit.Title">SpatialKit 空间索引</x:String>
  <x:String x:Key="String.Page.SpatialKit.Description">查看运行中的索引实例、分区和单位疏密。</x:String>
  <x:String x:Key="String.Page.UIKit.Title">UIKit 运行时诊断</x:String>
  <x:String x:Key="String.Page.UIKit.Description">观察 Unity 面板生命周期、命名栈、缓存和模态状态。</x:String>
  <x:String x:Key="String.Page.TableKit.Title">TableKit 数据生成</x:String>
  <x:String x:Key="String.Page.TableKit.Description">读取 Luban 配置、验证 target 并一键生成表代码与数据。</x:String>
  <x:String x:Key="String.Page.LocalizationKit.Title">LocalizationKit 本地化</x:String>
  <x:String x:Key="String.Page.LocalizationKit.Description">预览、搜索本地化文本并检查语言缺失。</x:String>
  <x:String x:Key="String.Page.SaveKit.Title">SaveKit 存档工作台</x:String>
  <x:String x:Key="String.Page.SaveKit.Description">配置存档目录、扩展名并浏览槽位与 Global 文件。</x:String>

