<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- AudioKit 只投影 Runtime 观察事实；页面不包含混音或播放控制。 -->
  <Style Selector="UserControl.audiokit-page TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Sm}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="TextBlock.audiokit-label">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Sm}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.audiokit-status-strip">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
  </Style>
  <Style Selector="TextBlock.audiokit-stale-text">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Sm}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
  </Style>
  <Style Selector="Border.audiokit-status-chip">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Elevated}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.audiokit-status-chip.warning">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Warning}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.WarningText}" />
  </Style>
  <Style Selector="TextBox.audiokit-toolbar-field, ComboBox.audiokit-toolbar-field">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Sm}" />
  </Style>
  <Style Selector="ToggleButton.audiokit-toolbar-toggle">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Sm}" />
  </Style>
  <Style Selector="ToggleButton.audiokit-toolbar-toggle:checked">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Action.Primary}" />
  </Style>
  <Style Selector="ListBox.audiokit-bus-channels">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource Padding.ScrollGutter}" />
  </Style>
  <Style Selector="ListBox.audiokit-bus-channels > ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="ListBox.audiokit-bus-channels > ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
  </Style>
  <Style Selector="Border.audiokit-bus-card">
    <Setter Property="MinWidth" Value="140" />
    <Setter Property="MinHeight" Value="104" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1,3,1,1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style Selector="Border.audiokit-bus-card.dynamic">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.WarningText}" />
  </Style>
  <Style Selector="ListBox.audiokit-bus-channels > ListBoxItem:selected Border.audiokit-bus-card">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Action.Primary}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Action.Selected}" />
  </Style>
  <Style Selector="TextBlock.audiokit-bus-name">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Md}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.audiokit-bus-source">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Sm}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>
  <Style Selector="Border.audiokit-count-badge">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Elevated}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Badge}" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="TextBlock.audiokit-voice-count">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Md}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ListBox.audiokit-detail-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource Padding.ScrollGutter}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
  </Style>
  <Style Selector="ListBox.audiokit-detail-list ListBoxItem">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="ListBox.audiokit-detail-list ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.CardHover}" />
  </Style>
  <Style Selector="TextBlock.audiokit-table-header, Grid.audiokit-table-header TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Sm}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
  </Style>
  <Style Selector="Grid.audiokit-table-header">
    <Setter Property="Margin" Value="0,2,0,4" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
  </Style>
  <Style Selector="TextBlock.audiokit-table-value">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Sm}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="TextBlock.audiokit-table-subvalue">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Sm}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
  </Style>
  <Style Selector="Border.audiokit-detail-panel">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Panel}" />
  </Style>
  <Style Selector="TextBlock.audiokit-empty-text">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Sm}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="MaxWidth" Value="420" />
  </Style>
  <Style Selector="GridSplitter.audiokit-splitter, GridSplitter.audiokit-detail-splitter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="GridSplitter.audiokit-splitter:pointerover, GridSplitter.audiokit-detail-splitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Border.Strong}" />
  </Style>
  <Style Selector="Border.audiokit-index-drawer">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Panel}" />
  </Style>
  <Style Selector="ToggleButton.audiokit-drawer-toggle">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Panel}" />
  </Style>
  <Style Selector="ToggleButton.audiokit-drawer-toggle:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.CardHover}" />
  </Style>
  <Style Selector="ToggleButton.audiokit-drawer-toggle:checked">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
  </Style>
  <Style Selector="ToggleButton.audiokit-drawer-toggle:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
  </Style>
  <Style Selector="TextBlock.audiokit-form-label, TextBlock.audiokit-index-label">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Sm}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.audiokit-index-help">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Sm}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
  </Style>
  <Style Selector="UserControl.audiokit-page.audiokit-compact Border.audiokit-wide-detail">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="UserControl.audiokit-page.audiokit-wide TabControl.audiokit-compact-detail">
    <Setter Property="IsVisible" Value="False" />
  </Style>
</Styles>
