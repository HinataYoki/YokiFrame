<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.savekit-stat">
    <Setter Property="MinWidth" Value="104" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="Border.savekit-config-summary">
    <Setter Property="MinWidth" Value="220" />
    <Setter Property="Padding" Value="12,7" />
  </Style>
  <Style Selector="TextBlock.savekit-path">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Border.savekit-resolved-path">
    <Setter Property="Padding" Value="10" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
  </Style>
  <Style Selector="TextBlock.savekit-resolved-path-text">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Xs}" />
  </Style>
  <Style Selector="Border.savekit-path-state">
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Badge}" />
  </Style>
  <Style Selector="Border.savekit-path-state TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Micro}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.savekit-path-state.ready">
    <Setter Property="Background" Value="{DynamicResource Brush.Status.SuccessSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Positive}" />
  </Style>
  <Style Selector="Border.savekit-path-state.ready TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Status.SuccessText}" />
  </Style>
  <Style Selector="Border.savekit-path-state.warning">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Warning}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
  </Style>
  <Style Selector="Border.savekit-path-state.warning TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Status.WarningText}" />
  </Style>
  <Style Selector="GridSplitter.savekit-master-splitter">
    <Setter Property="Width" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="GridSplitter.savekit-master-splitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Border.Strong}" />
  </Style>
  <Style Selector="Border.savekit-files-header">
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
</Styles>
