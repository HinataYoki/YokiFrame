<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shapes="using:Avalonia.Controls.Shapes">
  <Style Selector="Border.page-header">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,0,0,12" />
  </Style>
  <Style Selector="Border.compact-card">
    <Setter Property="MinHeight" Value="64" />
  </Style>
  <Style Selector="Border.metric-card">
    <Setter Property="MinHeight" Value="68" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="Border.installer-rail">
    <Setter Property="Background" Value="{DynamicResource Brush.Installer.Rail}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Installer.RailBorder}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="TextBlock.installer-rail-brand">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Installer.RailText}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.installer-rail-kicker">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Installer.RailMuted}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.installer-step-marker">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Installer.RailBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.installer-step-marker.active">
    <Setter Property="Background" Value="{DynamicResource Brush.Action.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Action.Primary}" />
  </Style>
  <Style Selector="TextBlock.installer-step-number">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Installer.RailMuted}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.installer-step-number.active">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="TextBlock.installer-step-title">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Installer.RailMuted}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.installer-step-title.active">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Installer.RailText}" />
  </Style>
  <Style Selector="TextBlock.installer-step-caption">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Installer.RailMuted}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Border.installer-rail-status">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Installer.RailBorder}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="12,12,0,0" />
  </Style>
  <Style Selector="TextBlock.installer-rail-engine">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Installer.RailText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.installer-titlebar">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="ScrollViewer.installer-workspace">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
  </Style>
  <Style Selector="TextBlock.installer-field-index">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Action.Primary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.installer-review-pane">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>
  <Style Selector="Border.status-card">
    <Setter Property="Padding" Value="13,10" />
  </Style>
  <Style Selector="Border.installer-warning-band">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Warning}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.DocsToc}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.installer-result-band">
    <Setter Property="Background" Value="{DynamicResource Brush.Status.SuccessSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Positive}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.installer-error-band">
    <Setter Property="Background" Value="{DynamicResource Brush.Status.DangerSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Terminal.Error}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.installer-footer">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Grid.installer-log-header">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
    <Setter Property="MinHeight" Value="42" />
  </Style>
  <Style Selector="ToggleButton.installer-log-toggle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ToggleButton.installer-log-toggle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.CardHover}" />
  </Style>
  <Style Selector="ToggleButton.installer-log-toggle:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.CardHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="Grid.installer-commandbar">
    <Setter Property="MinHeight" Value="68" />
    <Setter Property="Margin" Value="22,0,18,0" />
  </Style>
  <Style Selector="StackPanel.installer-button-content">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.installer-button-content > TextBlock, StackPanel.installer-button-content > shapes|Path">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource Brush.Border.Subtle}" />
  </Style>
  <Style Selector="Border.docs-nav-panel">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1,3,1,1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Panel}" />
  </Style>
  <Style Selector="Border.docs-article-panel">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Action.Primary}" />
    <Setter Property="BorderThickness" Value="1,3,1,1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Panel}" />
  </Style>
  <Style Selector="Border.docs-toc-panel">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.DocsToc}" />
    <Setter Property="BorderThickness" Value="1,3,1,1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Panel}" />
  </Style>
  <Style Selector="Border.docs-hero">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.DocsHero}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.DocsAccent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
    <Setter Property="Padding" Value="22,18" />
  </Style>
  <Style Selector="Border.docs-hero /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.DocsHero}" />
  </Style>
  <Style Selector="Border.docs-code-block">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.DocsCode}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
  </Style>
  <Style Selector="Border.docs-table">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
  </Style>
  <Style Selector="ItemsControl.docs-table-row">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
</Styles>
