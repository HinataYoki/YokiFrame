<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="ComboBox, TextBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Elevated}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Input}" />
  </Style>
  <Style Selector="TextBox.form-input">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Input}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Md}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ComboBox.titlebar-select">
    <Setter Property="Height" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Action.Primary}" />
  </Style>
  <Style Selector="ComboBox:pointerover, TextBox:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
  </Style>
  <Style Selector="ComboBox:focus, TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Action.Primary}" />
  </Style>
  <Style Selector="RadioButton.install-mode-option">
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="SegmentBorder"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.install-mode-option.segment-left">
    <Setter Property="CornerRadius" Value="5,0,0,5" />
  </Style>
  <Style Selector="RadioButton.install-mode-option.segment-right">
    <Setter Property="CornerRadius" Value="0,5,5,0" />
    <Setter Property="Margin" Value="-1,0,0,0" />
  </Style>
  <Style Selector="RadioButton.install-mode-option:checked">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Action.Primary}" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="32" />
  </Style>
</Styles>
