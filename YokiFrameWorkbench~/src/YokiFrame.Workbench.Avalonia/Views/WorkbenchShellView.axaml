<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             xmlns:components="using:YokiFrame.Workbench.Avalonia.Components"
             xmlns:doc="using:Avalonia.Controls.Documents"
             xmlns:vm="using:YokiFrame.Workbench.Avalonia.ViewModels"
             xmlns:pages="using:YokiFrame.Workbench.Avalonia.Views.Pages"
             x:Class="YokiFrame.Workbench.Avalonia.Views.WorkbenchShellView"
             x:DataType="vm:WorkbenchShellViewModel">
  <Grid RowDefinitions="60,*"
        Background="{DynamicResource Brush.App.Background}"
        doc:TextElement.FontFamily="{CompiledBinding SelectedDisplayFontFamily}">
    <components:AppTitleBar ZIndex="1" />
    <StackPanel x:Name="BrandArea"
            Grid.Row="0"
            Orientation="Horizontal"
            Width="224"
            Height="60"
            Margin="16,0,0,0"
            Spacing="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            ZIndex="2"
            chrome:WindowDecorationProperties.ElementRole="User">
      <Image Source="avares://YokiFrame.Workbench.Avalonia/Assets/Brand/yoki.png"
             Width="48"
             Height="48"
             Stretch="Uniform" />
      <TextBlock Text="YokiFrame"
                 FontSize="20"
                 FontWeight="Bold"
                 VerticalAlignment="Center" />
    </StackPanel>

    <Grid Grid.Row="1"
          ColumnDefinitions="224,*"
          Margin="16,0,16,16"
          ColumnSpacing="16">
      <components:SideNavigation />

      <Border x:Name="ToolWindowCard"
              Grid.Column="1"
              Classes="panel"
              Padding="20">
        <Grid RowDefinitions="Auto,*"
              RowSpacing="12">
          <Border Classes="page-header">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="20">
              <StackPanel x:Name="PageIntroduction"
                          Spacing="3"
                          MinWidth="180"
                          MaxWidth="280"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                <TextBlock Text="{CompiledBinding CurrentPageTitle}"
                           Classes="h2 page-title" />
                <TextBlock Text="{CompiledBinding CurrentPageDescription}"
                           Classes="muted"
                           FontSize="{DynamicResource FontSize.Sm}"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center">
                <StackPanel IsVisible="{CompiledBinding IsDocumentationPage}"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                  <TextBox Width="248"
                           Text="{CompiledBinding DocumentationPage.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="{DynamicResource String.Docs.SearchPlaceholder}"
                           KeyDown="OnDocumentationSearchKeyDown"
                           AutomationProperties.Name="{DynamicResource String.Docs.SearchAutomationName}"
                           AutomationProperties.AutomationId="workbench.docs.search" />
                  <Button Command="{CompiledBinding DocumentationPage.SearchCommand}"
                          Classes="secondary icon"
                           ToolTip.Tip="{DynamicResource String.Docs.SearchTooltip}"
                           AutomationProperties.Name="{DynamicResource String.Docs.SearchAutomationName}">
                    <PathIcon Data="{StaticResource Icon.Search}" Width="14" Height="14" />
                  </Button>
                </StackPanel>
                <StackPanel IsVisible="{CompiledBinding IsTableKitPage}"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                  <Button Command="{CompiledBinding TableKitPage.ResetCommand}"
                          Classes="secondary compact-action"
                           ToolTip.Tip="{DynamicResource String.TableKit.RestoreTooltip}"
                           AutomationProperties.Name="{DynamicResource String.TableKit.RestoreAutomationName}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <PathIcon Data="{StaticResource Icon.RotateCcw}" Width="13" Height="13" />
                      <TextBlock Text="{DynamicResource String.TableKit.RestoreDefault}" />
                    </StackPanel>
                  </Button>
                  <Button Command="{CompiledBinding TableKitPage.OpenConfigDirectoryCommand}"
                          Classes="secondary compact-action"
                           ToolTip.Tip="{DynamicResource String.TableKit.OpenConfigTooltip}"
                           AutomationProperties.Name="{DynamicResource String.TableKit.OpenConfigAutomationName}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <PathIcon Data="{StaticResource Icon.Folder}" Width="13" Height="13" />
                      <TextBlock Text="{DynamicResource String.TableKit.OpenConfig}" />
                    </StackPanel>
                  </Button>
                  <Button Command="{CompiledBinding TableKitPage.SaveCommand}"
                          Classes="secondary compact-action"
                           ToolTip.Tip="{DynamicResource String.TableKit.SaveTooltip}"
                           AutomationProperties.Name="{DynamicResource String.TableKit.SaveAutomationName}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <PathIcon Data="{StaticResource Icon.Save}" Width="13" Height="13" />
                      <TextBlock Text="{DynamicResource String.Common.Save}" />
                    </StackPanel>
                  </Button>
                  <Button Command="{CompiledBinding TableKitPage.ValidateCommand}"
                          Classes="secondary compact-action"
                           ToolTip.Tip="{DynamicResource String.TableKit.ValidateTooltip}"
                           AutomationProperties.Name="{DynamicResource String.TableKit.ValidateAutomationName}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <PathIcon Data="{StaticResource Icon.Eye}" Width="13" Height="13" />
                      <TextBlock Text="{DynamicResource String.TableKit.Validate}" />
                    </StackPanel>
                  </Button>
                  <Button Command="{CompiledBinding TableKitPage.GenerateCommand}"
                          Classes="primary compact-action"
                           ToolTip.Tip="{DynamicResource String.TableKit.GenerateTooltip}"
                           AutomationProperties.Name="{DynamicResource String.TableKit.GenerateAutomationName}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <PathIcon Data="{StaticResource Icon.Download}" Width="13" Height="13" />
                      <TextBlock Text="{DynamicResource String.TableKit.Generate}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <StackPanel IsVisible="{CompiledBinding IsLocalizationKitPage}"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                  <Border Classes="badge">
                    <TextBlock Text="{CompiledBinding LocalizationKitPage.ProviderText}" Classes="mono" />
                  </Border>
                  <TextBlock Text="{CompiledBinding LocalizationKitPage.SummaryText}"
                             Classes="muted mono"
                             FontSize="{DynamicResource FontSize.Sm}"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{CompiledBinding LocalizationKitPage.StatusText}"
                             Classes="muted"
                             FontSize="{DynamicResource FontSize.Sm}"
                             MaxWidth="180"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{CompiledBinding LocalizationKitPage.StatusText}"
                             VerticalAlignment="Center" />
                  <Button Command="{CompiledBinding LocalizationKitPage.RefreshCommand}"
                          Classes="secondary icon"
                           ToolTip.Tip="{DynamicResource String.Common.Refresh}"
                           AutomationProperties.Name="{DynamicResource String.Common.Refresh}">
                    <PathIcon Data="{StaticResource Icon.RotateCcw}" Width="14" Height="14" />
                  </Button>
                </StackPanel>
                <StackPanel IsVisible="{CompiledBinding IsEventKitPage}"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                  <TextBox Width="260"
                           Text="{CompiledBinding EventKitPage.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{DynamicResource String.EventKit.SearchPlaceholder}"
                            AutomationProperties.Name="{DynamicResource String.EventKit.SearchAutomationName}"
                           AutomationProperties.AutomationId="workbench.eventkit.search" />
                  <ComboBox Width="108"
                            ItemsSource="{CompiledBinding EventKitPage.ChannelOptions}"
                            SelectedItem="{CompiledBinding EventKitPage.SelectedChannel, Mode=TwoWay}"
                             AutomationProperties.Name="{DynamicResource String.EventKit.ChannelFilter}" />
                   <CheckBox Content="{DynamicResource String.EventKit.ExcludeEditor}"
                            IsChecked="{CompiledBinding EventKitPage.ExcludeEditor, Mode=TwoWay}"
                            VerticalAlignment="Center"
                             AutomationProperties.Name="{DynamicResource String.EventKit.ExcludeEditorAutomationName}" />
                  <TextBlock Text="{CompiledBinding EventKitPage.ScanStatusText}"
                             Classes="muted"
                             FontSize="{DynamicResource FontSize.Xs}"
                             MaxWidth="118"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{CompiledBinding EventKitPage.ScanFileCountText}"
                             VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel IsVisible="{CompiledBinding IsLogKitPage}"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                  <Button x:Name="OpenLogDirectoryButton"
                          Command="{CompiledBinding LogKitPage.OpenDirectoryCommand}"
                          Classes="secondary icon"
                          ToolTip.Tip="{DynamicResource String.LogKit.OpenDirectoryTooltip}"
                          AutomationProperties.Name="{DynamicResource String.LogKit.OpenDirectoryAutomationName}"
                          AutomationProperties.HelpText="{CompiledBinding LogKitPage.LogDirectoryPathText}">
                    <PathIcon Data="{StaticResource Icon.Folder}" Width="14" Height="14" />
                  </Button>
                   <Button Content="{DynamicResource String.LogKit.RestoreDefault}"
                          Command="{CompiledBinding LogKitPage.ResetSettingsCommand}"
                          Classes="secondary compact-action"
                           ToolTip.Tip="{DynamicResource String.LogKit.RestoreDefaultTooltip}" />
                   <Button Content="{CompiledBinding LogKitPage.SaveSettingsButtonText}"
                           Command="{CompiledBinding LogKitPage.SaveSettingsCommand}"
                           Classes="primary compact-action" />
                 </StackPanel>
                 <Button IsVisible="{CompiledBinding IsSaveKitPage}"
                         Command="{CompiledBinding SaveKitPage.OpenDirectoryCommand}"
                         Classes="secondary icon"
                          ToolTip.Tip="{DynamicResource String.SaveKit.OpenDirectoryTooltip}"
                          AutomationProperties.Name="{DynamicResource String.SaveKit.OpenDirectoryAutomationName}">
                   <PathIcon Data="{StaticResource Icon.Folder}" Width="14" Height="14" />
                 </Button>
                 <Button IsVisible="{CompiledBinding IsSaveKitPage}"
                         Command="{CompiledBinding SaveKitPage.ResetCommand}"
                         Classes="secondary icon"
                          ToolTip.Tip="{DynamicResource String.SaveKit.ResetTooltip}"
                          AutomationProperties.Name="{DynamicResource String.SaveKit.ResetAutomationName}">
                   <PathIcon Data="{StaticResource Icon.RotateCcw}" Width="14" Height="14" />
                 </Button>
                 <StackPanel IsVisible="{CompiledBinding IsPoolKitPage}"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                  <TextBlock Text="{CompiledBinding PoolKitPage.OperationStatusText}"
                             Classes="muted"
                             FontSize="{DynamicResource FontSize.Sm}"
                             MaxWidth="220"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{CompiledBinding PoolKitPage.OperationStatusText}"
                             AutomationProperties.LiveSetting="Polite"
                             VerticalAlignment="Center" />
                  <ToggleButton IsChecked="{CompiledBinding PoolKitPage.TrackingEnabled, Mode=OneWay}"
                                Command="{CompiledBinding PoolKitPage.ToggleTrackingCommand}"
                                Classes="poolkit-toolbar-toggle"
                                 AutomationProperties.Name="{DynamicResource String.PoolKit.TrackingAutomationName}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <PathIcon Data="{StaticResource Icon.Eye}" Width="13" Height="13" />
                      <TextBlock Text="{CompiledBinding PoolKitPage.TrackingButtonText}" />
                    </StackPanel>
                  </ToggleButton>
                  <ToggleButton IsChecked="{CompiledBinding PoolKitPage.StackTraceEnabled, Mode=OneWay}"
                                Command="{CompiledBinding PoolKitPage.ToggleLocationCommand}"
                                Classes="poolkit-toolbar-toggle"
                                 ToolTip.Tip="{DynamicResource String.PoolKit.LocationTooltip}"
                                 AutomationProperties.Name="{DynamicResource String.PoolKit.LocationAutomationName}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <PathIcon Data="{StaticResource Icon.Crosshair}" Width="13" Height="13" />
                      <TextBlock Text="{CompiledBinding PoolKitPage.LocationButtonText}" />
                    </StackPanel>
                  </ToggleButton>
                   <Button Command="{CompiledBinding PoolKitPage.CheckLeaksCommand}"
                           Classes="secondary compact-action"
                            ToolTip.Tip="{DynamicResource String.PoolKit.CheckLeaksTooltip}"
                            AutomationProperties.HelpText="{DynamicResource String.PoolKit.CheckLeaksHelp}"
                            AutomationProperties.Name="{DynamicResource String.PoolKit.CheckLeaksAutomationName}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <PathIcon Data="{StaticResource Icon.TriangleAlert}" Width="13" Height="13" />
                      <TextBlock Text="{DynamicResource String.PoolKit.CheckLeaks}" />
                    </StackPanel>
                  </Button>
                  <Button Command="{CompiledBinding PoolKitPage.ClearHistoryCommand}"
                          Classes="secondary compact-action">
                    <Button.Content>
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <PathIcon Data="{StaticResource Icon.Trash2}" Width="13" Height="13" />
                        <TextBlock Text="{DynamicResource String.Common.ClearHistory}" />
                      </StackPanel>
                    </Button.Content>
                  </Button>
                  <Button Command="{CompiledBinding RefreshCommand}"
                          Classes="primary compact-action"
                           AutomationProperties.Name="{DynamicResource String.Common.Refresh}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <PathIcon Data="{StaticResource Icon.RotateCcw}" Width="13" Height="13" />
                      <TextBlock Text="{DynamicResource String.Common.Refresh}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <StackPanel IsVisible="{CompiledBinding IsResKitPage}"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                  <TextBlock Text="{CompiledBinding ResKitPage.OperationStatusText}"
                             Classes="muted"
                             FontSize="{DynamicResource FontSize.Sm}"
                             MaxWidth="180"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{CompiledBinding ResKitPage.OperationStatusText}"
                             AutomationProperties.LiveSetting="Polite"
                             VerticalAlignment="Center" />
                  <ToggleButton IsChecked="{CompiledBinding ResKitPage.TrackingEnabled, Mode=OneWay}"
                                Command="{CompiledBinding ResKitPage.ToggleTrackingCommand}"
                                Classes="reskit-toolbar-toggle"
                                 ToolTip.Tip="{DynamicResource String.ResKit.TrackingTooltip}"
                                 AutomationProperties.Name="{DynamicResource String.ResKit.TrackingAutomationName}"
                                 AutomationProperties.HelpText="{DynamicResource String.ResKit.TrackingHelp}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <PathIcon Data="{StaticResource Icon.Crosshair}" Width="13" Height="13" />
                      <TextBlock Text="{CompiledBinding ResKitPage.TrackingButtonText}" />
                    </StackPanel>
                  </ToggleButton>
                  <Button
                          Command="{CompiledBinding ResKitPage.ClearHistoryCommand}"
                          Classes="secondary compact-action"
                           AutomationProperties.Name="{DynamicResource String.Common.ClearHistory}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <PathIcon Data="{StaticResource Icon.Trash2}" Width="13" Height="13" />
                      <TextBlock Text="{DynamicResource String.Common.ClearHistory}" />
                    </StackPanel>
                  </Button>
                  <Button
                          Command="{CompiledBinding RefreshCommand}"
                          Classes="primary compact-action"
                           AutomationProperties.Name="{DynamicResource String.Common.Refresh}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <PathIcon Data="{StaticResource Icon.RotateCcw}" Width="13" Height="13" />
                      <TextBlock Text="{DynamicResource String.Common.Refresh}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <StackPanel IsVisible="{CompiledBinding IsActionKitPage}"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                  <TextBlock Text="{CompiledBinding ActionKitPage.OperationStatusText}"
                             Classes="muted"
                             FontSize="{DynamicResource FontSize.Sm}"
                             MaxWidth="170"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{CompiledBinding ActionKitPage.OperationStatusText}"
                              AutomationProperties.Name="{DynamicResource String.ActionKit.StatusAutomationName}"
                             AutomationProperties.LiveSetting="Polite"
                             VerticalAlignment="Center" />
                  <ToggleButton Command="{CompiledBinding ActionKitPage.ToggleStackTraceCommand}"
                                IsChecked="{CompiledBinding ActionKitPage.StackTraceEnabled, Mode=OneWay}"
                                Classes="actionkit-toolbar-toggle"
                                 ToolTip.Tip="{DynamicResource String.ActionKit.StackTraceTooltip}"
                                 AutomationProperties.Name="{DynamicResource String.ActionKit.StackTraceAutomationName}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <PathIcon Data="{StaticResource Icon.Eye}" Width="13" Height="13" />
                      <TextBlock Text="{CompiledBinding ActionKitPage.StackTraceButtonText}" />
                    </StackPanel>
                  </ToggleButton>
                  <Button Command="{CompiledBinding ActionKitPage.ClearStackTraceCommand}"
                          Classes="secondary compact-action"
                           ToolTip.Tip="{DynamicResource String.ActionKit.ClearStackTraceTooltip}"
                           AutomationProperties.Name="{DynamicResource String.ActionKit.ClearStackTraceAutomationName}"
                           AutomationProperties.HelpText="{DynamicResource String.ActionKit.ClearStackTraceHelp}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <PathIcon Data="{StaticResource Icon.Trash2}" Width="13" Height="13" />
                       <TextBlock Text="{DynamicResource String.Common.ClearHistory}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <Button Content="{DynamicResource String.Overview.Refresh}"
                        Command="{CompiledBinding RefreshCommand}"
                        Classes="secondary"
                        IsVisible="{CompiledBinding IsOverviewPage}" />
                <Button Content="{DynamicResource String.Overview.Refresh}"
                        Command="{CompiledBinding RefreshCommand}"
                        Classes="secondary"
                        IsVisible="{CompiledBinding IsDetailPage}" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid Grid.Row="1">
          <Grid IsVisible="{CompiledBinding IsOverviewPage}">
            <Grid x:Name="OverviewDesignSurface"
                  ColumnDefinitions="*,420"
                  ColumnSpacing="12">
              <Grid RowDefinitions="Auto,52,*"
                    RowSpacing="8">
                <Border Classes="panel"
                        Padding="10">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{DynamicResource String.Overview.RuntimeStatus}"
                               Classes="section-title" />
                    <ItemsControl ItemsSource="{CompiledBinding SummaryCards}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkbenchMetricCard">
                          <components:MetricCard Classes="overview-metric-card" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{CompiledBinding EngineCards}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkbenchMetricCard">
                          <components:MetricCard Classes="overview-metric-card" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Classes="panel"
                        Padding="8">
                  <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,132"
                        ColumnSpacing="6">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource String.Overview.CommandBridge}"
                                 FontSize="{DynamicResource FontSize.Md}"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center" />
                      <Border Classes="badge"
                              Padding="6,2">
                        <TextBlock Text="{CompiledBinding ConnectionBadgeText}"
                                   Foreground="{DynamicResource Brush.Status.SuccessText}"
                                   FontSize="{DynamicResource FontSize.Xs}"
                                   FontWeight="SemiBold" />
                      </Border>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{DynamicResource String.Overview.Ping}"
                            Command="{CompiledBinding PingCommand}"
                            Classes="primary compact-action" />
                    <Button Grid.Column="2"
                            Content="{DynamicResource String.Overview.Status}"
                            Command="{CompiledBinding BridgeStatusCommand}"
                            Classes="secondary compact-action" />
                    <Button Grid.Column="3"
                            Content="{DynamicResource String.Overview.Catalog}"
                            Command="{CompiledBinding RefreshCommandCatalogCommand}"
                            Classes="secondary compact-action" />
                    <TextBlock Grid.Column="5"
                               Text="{DynamicResource String.Overview.FontLabel}"
                               Classes="muted"
                               FontSize="{DynamicResource FontSize.Sm}"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Column="6"
                              MinHeight="30"
                              ItemsSource="{CompiledBinding DisplayFontOptions}"
                              SelectedItem="{CompiledBinding SelectedDisplayFontName, Mode=TwoWay}" />
                  </Grid>
                </Border>

                <components:LogConsole Grid.Row="2" />
              </Grid>

              <Border Grid.Column="1"
                      Classes="panel overview-skill-panel"
                      Padding="10">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
                      RowSpacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{DynamicResource String.Overview.SkillsTitle}"
                               Classes="section-title" />
                    <TextBlock Text="{CompiledBinding SkillInstallStatusText}"
                               Classes="muted"
                               FontSize="{DynamicResource FontSize.Sm}"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{CompiledBinding SkillInstallStatusText}" />
                  </StackPanel>

                  <ItemsControl Grid.Row="1"
                                ItemsSource="{CompiledBinding SkillStatusCards}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WorkbenchMetricCard">
                        <components:MetricCard Classes="overview-metric-card" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <ItemsControl Grid.Row="2"
                                ItemsSource="{CompiledBinding SkillOptions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WorkbenchSkillOption">
                        <Button Command="{CompiledBinding SelectCommand}"
                                Classes="skill-option-card"
                                Classes.active="{CompiledBinding IsSelected}"
                                HorizontalAlignment="Stretch">
                           <StackPanel Spacing="2">
                             <TextBlock Text="{CompiledBinding Label}"
                                        FontWeight="SemiBold"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip.Tip="{CompiledBinding Label}" />
                             <TextBlock Text="{CompiledBinding Description}"
                                        Classes="mono muted"
                                        FontSize="{DynamicResource FontSize.Xs}"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip.Tip="{CompiledBinding Description}" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <ItemsControl Grid.Row="3"
                                Classes="overview-skill-target-list"
                                VerticalAlignment="Top"
                                ItemsSource="{CompiledBinding SkillTargets}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WorkbenchSkillTarget">
                        <Border Classes="card skill-target-row">
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                ColumnSpacing="6">
                            <StackPanel Spacing="1"
                                        VerticalAlignment="Center">
                              <TextBlock Text="{CompiledBinding Label}"
                                         FontSize="{DynamicResource FontSize.Md}"
                                         FontWeight="SemiBold"
                                         MaxLines="1"
                                         TextTrimming="CharacterEllipsis"
                                         ToolTip.Tip="{CompiledBinding Label}" />
                              <TextBlock Text="{CompiledBinding RelativePath}"
                                         Classes="mono muted"
                                         FontSize="{DynamicResource FontSize.Xs}"
                                         MaxLines="1"
                                         TextTrimming="CharacterEllipsis"
                                         ToolTip.Tip="{CompiledBinding RelativePath}" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Classes="badge"
                                    Classes.positive="{CompiledBinding IsInstalled}"
                                    Classes.neutral="{CompiledBinding !IsInstalled}"
                                    Padding="6,2">
                              <TextBlock Text="{CompiledBinding StatusText}"
                                         Classes="muted"
                                         FontSize="{DynamicResource FontSize.Xs}" />
                            </Border>
                            <Button Grid.Column="2"
                                    Content="{DynamicResource String.Overview.Install}"
                                    Command="{CompiledBinding InstallCommand}"
                                    Classes="primary compact-action" />
                            <Button Grid.Column="3"
                                    Content="{DynamicResource String.Overview.Uninstall}"
                                    Command="{CompiledBinding UninstallCommand}"
                                    Classes="secondary compact-action" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Grid x:Name="OverviewCustomSkillPanel"
                        Grid.Row="4"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="4">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="6">
                      <TextBlock Text="{DynamicResource String.Overview.CustomDirectory}"
                                 FontSize="{DynamicResource FontSize.Md}"
                                 FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1"
                                 Text="{CompiledBinding CustomSkillStatusText}"
                                 Classes="muted"
                                 FontSize="{DynamicResource FontSize.Xs}"
                                 MaxLines="1"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{CompiledBinding CustomSkillStatusText}" />
                    </Grid>
                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="6">
                      <TextBox Text="{CompiledBinding CustomSkillPath, Mode=TwoWay}"
                               PlaceholderText="custom/skills" />
                      <Button Grid.Column="1"
                              Content="{DynamicResource String.Overview.Install}"
                              Command="{CompiledBinding InstallCustomSkillCommand}"
                              Classes="secondary" />
                      <Button Grid.Column="2"
                              Content="{DynamicResource String.Overview.Uninstall}"
                              Command="{CompiledBinding UninstallCustomSkillCommand}"
                              Classes="ghost" />
                    </Grid>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <Grid IsVisible="{CompiledBinding IsDetailPage}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{CompiledBinding CurrentSections}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:WorkbenchDisplaySection">
                    <Border BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            Padding="0,14">
                      <Grid ColumnDefinitions="180,*"
                            ColumnSpacing="20">
                        <TextBlock Text="{CompiledBinding Label}"
                                   Classes="section-title"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1"
                                   Text="{CompiledBinding Value}"
                                   Classes="mono"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <ContentControl IsVisible="{CompiledBinding IsWorkspacePage}"
                          Content="{CompiledBinding ActiveWorkspacePage}">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="{x:Type vm:EventKitPageViewModel}" x:DataType="vm:EventKitPageViewModel">
                <pages:EventKitPageView />
              </DataTemplate>
