<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokiFrame.Workbench.Avalonia.ViewModels"
             x:Class="YokiFrame.Workbench.Avalonia.Views.Pages.LogKitPageView"
             x:DataType="vm:LogKitPageViewModel">
  <Border x:Name="SettingsPanel"
          Classes="panel logkit-settings-panel"
          Padding="0">
    <Grid RowDefinitions="Auto,*,Auto">
      <Border Classes="logkit-runtime-banner">
        <Grid ColumnDefinitions="Auto,1,2*,1,Auto,1,Auto,1,Auto"
              ColumnSpacing="12">
          <Border Classes="logkit-runtime-status"
                  Classes.positive="{CompiledBinding RuntimeEnabled}"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"
                        Spacing="7">
              <Ellipse Width="8"
                       Height="8"
                       Classes="logkit-runtime-dot"
                       VerticalAlignment="Center" />
              <TextBlock Text="{CompiledBinding RuntimeStatusText}"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1"
                  Classes="logkit-runtime-separator" />

          <Grid Grid.Column="2"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="7"
                VerticalAlignment="Center">
            <TextBlock Text="Logger"
                       Classes="logkit-runtime-label" />
            <TextBlock Grid.Column="1"
                       Text="{CompiledBinding LoggerName}"
                       Classes="mono logkit-runtime-value"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{CompiledBinding LoggerName}" />
          </Grid>

          <Border Grid.Column="3"
                  Classes="logkit-runtime-separator" />

          <StackPanel Grid.Column="4"
                      Orientation="Horizontal"
                      Spacing="7"
                      VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource String.LogKit.MinimumLevel}"
                       Classes="logkit-runtime-label" />
            <TextBlock Text="{CompiledBinding RuntimeMinimumLevel}"
                       Classes="logkit-runtime-value" />
          </StackPanel>

          <Border Grid.Column="5"
                  Classes="logkit-runtime-separator" />

          <StackPanel Grid.Column="6"
                      Orientation="Horizontal"
                      Spacing="7"
                      VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource String.LogKit.MemoryHistory}"
                       Classes="logkit-runtime-label" />
            <TextBlock Text="{CompiledBinding RuntimeHistoryText}"
                       Classes="logkit-runtime-value"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{CompiledBinding RuntimeHistoryText}" />
          </StackPanel>

          <Border Grid.Column="7"
                  Classes="logkit-runtime-separator" />

          <StackPanel Grid.Column="8"
                      Orientation="Horizontal"
                      Spacing="7"
                      VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource String.LogKit.DataChannel}"
                       Classes="logkit-runtime-label" />
            <TextBlock Text="{CompiledBinding DataChannelText}"
                       Classes="mono logkit-runtime-value"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{CompiledBinding DataChannelText}" />
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,16,0"
                    AutomationProperties.Name="{DynamicResource String.LogKit.SettingsAutomationName}">
        <Grid x:Name="ConfigGrid"
              Margin="16"
              ColumnDefinitions="*,*"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="16"
              RowSpacing="16"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              IsEnabled="{CompiledBinding ProjectCanPersist}">
          <Border x:Name="OutputSettingsCard"
                  Grid.Row="1"
                  Grid.Column="0"
                  Classes="card logkit-section-card">
              <StackPanel Spacing="8">
                <StackPanel Spacing="3">
                  <TextBlock Text="{DynamicResource String.LogKit.OutputTargets}"
                             Classes="logkit-section-title" />
                  <TextBlock Text="{DynamicResource String.LogKit.OutputTargetsHint}"
                             Classes="logkit-helper" />
                </StackPanel>

                <Border Classes="logkit-setting-row">
                  <Grid ColumnDefinitions="*,Auto"
                        Background="Transparent"
                        Cursor="Hand"
                        Tag="LogKitEnabledToggle"
                        PointerPressed="OnSettingLabelPointerPressed">
                    <TextBlock Text="{DynamicResource String.LogKit.Enabled}"
                               Classes="logkit-setting-label"
                               VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="LogKitEnabledToggle"
                                  Grid.Column="1"
                                  Classes="logkit-editor"
                                  OnContent="{DynamicResource String.LogKit.On}"
                                  OffContent="{DynamicResource String.LogKit.Off}"
                                  IsChecked="{CompiledBinding SettingsDraft.Enabled, Mode=TwoWay}" />
                  </Grid>
                </Border>

                <Border Classes="logkit-setting-row">
                  <Grid ColumnDefinitions="*,Auto"
                        Background="Transparent"
                        Cursor="Hand"
                        Tag="EditorFileWriteToggle"
                        PointerPressed="OnSettingLabelPointerPressed">
                    <TextBlock x:Name="EditorFileWriteLabel"
                               Text="{DynamicResource String.LogKit.EditorFileWrite}"
                               Classes="logkit-setting-label"
                               VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="EditorFileWriteToggle"
                                  Grid.Column="1"
                                  Classes="logkit-editor"
                                  OnContent="{DynamicResource String.LogKit.On}"
                                  OffContent="{DynamicResource String.LogKit.Off}"
                                  IsChecked="{CompiledBinding SettingsDraft.SaveLogInEditor, Mode=TwoWay}" />
                  </Grid>
                </Border>

                <Border Classes="logkit-setting-row">
                  <Grid ColumnDefinitions="*,Auto"
                        Background="Transparent"
                        Cursor="Hand"
                        Tag="PlayerFileWriteToggle"
                        PointerPressed="OnSettingLabelPointerPressed">
                    <TextBlock Text="{DynamicResource String.LogKit.PlayerFileWrite}"
                               Classes="logkit-setting-label"
                               VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="PlayerFileWriteToggle"
                                  Grid.Column="1"
                                  Classes="logkit-editor"
                                  OnContent="{DynamicResource String.LogKit.On}"
                                  OffContent="{DynamicResource String.LogKit.Off}"
                                  IsChecked="{CompiledBinding SettingsDraft.SaveLogInPlayer, Mode=TwoWay}" />
                  </Grid>
                </Border>

                <Border Classes="logkit-setting-row">
                  <Grid ColumnDefinitions="*,Auto"
                        Background="Transparent"
                        Cursor="Hand"
                        Tag="PlayerImGuiToggle"
                        PointerPressed="OnSettingLabelPointerPressed">
                    <TextBlock Text="{DynamicResource String.LogKit.PlayerImGui}"
                               Classes="logkit-setting-label"
                               VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="PlayerImGuiToggle"
                                  Grid.Column="1"
                                  Classes="logkit-editor"
                                  OnContent="{DynamicResource String.LogKit.On}"
                                  OffContent="{DynamicResource String.LogKit.Off}"
                                  IsChecked="{CompiledBinding SettingsDraft.EnableImGuiInPlayer, Mode=TwoWay}" />
                  </Grid>
                </Border>

                <Border Classes="logkit-setting-row">
                  <Grid ColumnDefinitions="*,Auto,Auto"
                        Background="Transparent"
                        Cursor="Hand"
                        Tag="EncryptionToggle"
                        PointerPressed="OnSettingLabelPointerPressed">
                    <TextBlock Text="{DynamicResource String.LogKit.Encryption}"
                               Classes="logkit-setting-label"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{CompiledBinding EncryptionStatusText}"
                               Classes="logkit-capability-value"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <ToggleSwitch x:Name="EncryptionToggle"
                                  Grid.Column="2"
                                  Classes="logkit-editor"
                                  OnContent="{DynamicResource String.LogKit.On}"
                                  OffContent="{DynamicResource String.LogKit.Off}"
                                  IsEnabled="{CompiledBinding SupportsEncryption}"
                                  ToolTip.Tip="{CompiledBinding EncryptionToggleToolTip}"
                                  IsChecked="{CompiledBinding EncryptionToggleValue, Mode=TwoWay}" />
                  </Grid>
                </Border>

                <Border Classes="logkit-setting-row">
                  <Grid ColumnDefinitions="*,Auto"
                        Background="Transparent">
                    <TextBlock Text="{DynamicResource String.LogKit.Decryption}"
                               Classes="logkit-setting-label"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{CompiledBinding DecryptionStatusText}"
                               Classes="logkit-capability-value"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <Border Classes="logkit-setting-row last">
                  <Grid ColumnDefinitions="*,Auto"
                        Background="Transparent">
                    <TextBlock Text="{DynamicResource String.LogKit.EncryptionMethod}"
                               Classes="logkit-setting-label"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{CompiledBinding EncryptionMethodText}"
                               Classes="logkit-capability-value"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{CompiledBinding EncryptionMethodText}"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

          <Border x:Name="FileSettingsCard"
                  Grid.Row="0"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Classes="card logkit-section-card">
              <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                  <TextBlock Text="{DynamicResource String.LogKit.LogFiles}"
                             Classes="logkit-section-title" />
                  <TextBlock Text="{DynamicResource String.LogKit.LogFilesHint}"
                             Classes="logkit-helper" />
                </StackPanel>
                <Grid x:Name="FileFieldsGrid"
                      ColumnDefinitions="2*,*,*"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="16"
                      RowSpacing="10">
                <StackPanel x:Name="LogDirectoryField"
                            Spacing="4">
                  <TextBlock Text="{DynamicResource String.LogKit.LogDirectory}"
                             Classes="logkit-field-label" />
                  <TextBox x:Name="LogDirectoryInput"
                           Classes="logkit-editor"
                           Text="{CompiledBinding SettingsDraft.LogDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="Application.persistentDataPath/LogFiles" />
                </StackPanel>
                <StackPanel x:Name="EditorFileNameField"
                            Grid.Column="1"
                            Spacing="4">
                  <TextBlock Text="{DynamicResource String.LogKit.EditorFileName}"
                             Classes="logkit-field-label" />
                  <TextBox Classes="logkit-editor"
                           Text="{CompiledBinding SettingsDraft.EditorFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel x:Name="PlayerFileNameField"
                            Grid.Column="2"
                            Spacing="4">
                  <TextBlock Text="{DynamicResource String.LogKit.PlayerFileName}"
                             Classes="logkit-field-label" />
                  <TextBox Classes="logkit-editor"
                           Text="{CompiledBinding SettingsDraft.PlayerFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                </Grid>
              </StackPanel>
          </Border>

          <Border x:Name="CapacitySettingsCard"
                  Grid.Row="1"
                  Grid.Column="1"
                  VerticalAlignment="Top"
                  Classes="card logkit-section-card">
            <StackPanel Spacing="10">
              <StackPanel Spacing="3">
                <TextBlock Text="{DynamicResource String.LogKit.CapacitySettings}"
                           Classes="logkit-section-title" />
                <TextBlock Text="{DynamicResource String.LogKit.CapacitySettingsHint}"
                           Classes="logkit-helper" />
              </StackPanel>
              <Grid ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="16"
                    RowSpacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Text="{DynamicResource String.LogKit.MinimumLevel}"
                             Classes="logkit-field-label" />
                  <ComboBox Classes="logkit-editor"
                            ItemsSource="{CompiledBinding SettingsLevelOptions}"
                            SelectedItem="{CompiledBinding SettingsDraft.MinimumLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Spacing="4">
                  <TextBlock Text="{DynamicResource String.LogKit.MaxQueueSize}"
                             Classes="logkit-field-label" />
                  <NumericUpDown Value="{CompiledBinding SettingsDraft.MaxQueueSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Classes="logkit-number logkit-editor"
                                 Minimum="1" Maximum="2147483647" Increment="100" FormatString="0" />
                </StackPanel>
                <StackPanel Grid.Row="1"
                            Spacing="4">
                  <TextBlock Text="{DynamicResource String.LogKit.MaxSameLogCount}"
                             Classes="logkit-field-label" />
                  <NumericUpDown Value="{CompiledBinding SettingsDraft.MaxSameLogCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Classes="logkit-number logkit-editor"
                                 Minimum="0" Maximum="2147483647" Increment="1" FormatString="0" />
                </StackPanel>
                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Spacing="4">
                  <TextBlock Text="{DynamicResource String.LogKit.MaxRetentionDays}"
                             Classes="logkit-field-label" />
                  <NumericUpDown Value="{CompiledBinding SettingsDraft.MaxRetentionDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Classes="logkit-number logkit-editor"
                                 Minimum="1" Maximum="3650" Increment="1" FormatString="0" />
                </StackPanel>
                <StackPanel Grid.Row="2"
                            Spacing="4">
                  <TextBlock Text="{DynamicResource String.LogKit.MaxFileSizeMb}"
                             Classes="logkit-field-label" />
                  <NumericUpDown Value="{CompiledBinding SettingsDraft.MaxFileSizeMb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Classes="logkit-number logkit-editor"
                                 Minimum="1" Maximum="2147483647" Increment="10" FormatString="0" />
                </StackPanel>
                <StackPanel Grid.Row="2"
                            Grid.Column="1"
                            Spacing="4">
                  <TextBlock Text="{DynamicResource String.LogKit.ImGuiMaxLogCount}"
                             Classes="logkit-field-label" />
                  <NumericUpDown Value="{CompiledBinding SettingsDraft.ImGuiMaxLogCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Classes="logkit-number logkit-editor"
                                 Minimum="1" Maximum="2147483647" Increment="10" FormatString="0" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>

      <Border Grid.Row="2"
              Classes="logkit-settings-footer">
        <Grid ColumnDefinitions="*,2*"
              ColumnSpacing="16">
          <TextBlock Text="{CompiledBinding SettingsStatusText}"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{CompiledBinding SettingsStatusText}"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{CompiledBinding ProjectSettingsPath}"
                     Classes="mono logkit-config-path"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{CompiledBinding ProjectSettingsPath}"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
