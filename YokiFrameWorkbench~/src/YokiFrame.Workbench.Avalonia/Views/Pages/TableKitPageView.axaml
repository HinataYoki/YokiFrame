<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokiFrame.Workbench.Avalonia.ViewModels"
             xmlns:pages="using:YokiFrame.Workbench.Avalonia.Views.Pages"
             x:Class="YokiFrame.Workbench.Avalonia.Views.Pages.TableKitPageView"
             x:DataType="vm:TableKitPageViewModel"
             Classes="tablekit-page"
             ToolTip.ShowDelay="300"
             AutomationProperties.AutomationId="workbench.tablekit.page">
  <Grid x:Name="TableKitRootLayout" RowDefinitions="Auto,*,0,36" MinHeight="500">
    <Border Classes="tablekit-status-strip" Margin="0,0,0,8">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,1,Auto" ColumnSpacing="9">
        <Border Classes="tablekit-status-chip"
                Classes.positive="{CompiledBinding LubanAvailable}"
                Classes.warning="{CompiledBinding LubanUnavailable}">
          <TextBlock Text="{CompiledBinding LubanStatusText}"
                     Classes="mono tablekit-kicker"
                     Foreground="{DynamicResource Brush.Text.Primary}" />
        </Border>
        <TextBlock Grid.Column="1"
                   Text="{CompiledBinding StatusText}"
                   Classes="tablekit-status-text"
                   VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock Grid.Column="2"
                   Text="{CompiledBinding EnvironmentMessage}"
                   Classes="tablekit-status-detail"
                   VerticalAlignment="Center"
                   ToolTip.Tip="{CompiledBinding EnvironmentMessage}"
                   AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource String.TableKit.Tables}" Classes="tablekit-metric-label" />
          <TextBlock Text="{CompiledBinding TablesType}"
                     Classes="mono tablekit-metric-value"
                     MaxWidth="180"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{CompiledBinding TablesType}" />
        </StackPanel>
        <Border Grid.Column="4" Classes="tablekit-divider" />
        <TextBlock Grid.Column="5"
                   Text="{CompiledBinding PreviewCountText}"
                   Classes="mono tablekit-status-detail"
                   VerticalAlignment="Center"
                   ToolTip.Tip="{CompiledBinding PreviewStatusText}" />
      </Grid>
    </Border>

    <TabControl x:Name="TableKitWorkspaceTabs"
                Grid.Row="1"
                SelectedIndex="{CompiledBinding SelectedWorkspaceIndex, Mode=TwoWay}"
                Classes="tablekit-workspace-tabs">
      <TabItem AutomationProperties.Name="{DynamicResource String.TableKit.ConfigurationTabAutomationName}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="7">
            <TextBlock Text="{DynamicResource String.TableKit.Configuration}" />
          </StackPanel>
        </TabItem.Header>
        <pages:TableKitConfigurationView x:Name="TableKitConfigView" />
      </TabItem>
      <TabItem IsEnabled="{CompiledBinding HasPreviewTables}"
               AutomationProperties.Name="{DynamicResource String.TableKit.DataPreviewTabAutomationName}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="7">
            <TextBlock Text="{DynamicResource String.TableKit.DataPreview}" />
            <TextBlock Text="{CompiledBinding PreviewCountText}" Classes="mono tablekit-tab-count" />
          </StackPanel>
        </TabItem.Header>
        <pages:TableKitDataView x:Name="TableKitDataView" />
      </TabItem>
    </TabControl>

    <GridSplitter x:Name="TableKitConsoleSplitter"
                  Grid.Row="2"
                  Classes="tablekit-console-splitter"
                  ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext"
                  IsVisible="False"
                  AutomationProperties.Name="{DynamicResource String.TableKit.ConsoleSplitterAutomationName}" />

    <Border x:Name="TableKitConsolePanel"
            Grid.Row="3"
            Classes="tablekit-console-panel">
      <Grid RowDefinitions="36,*">
        <Border Grid.Row="0" Classes="tablekit-console-header">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="7">
            <TextBlock Text="{DynamicResource String.TableKit.Console}" Classes="section-title" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{CompiledBinding ConsoleSummaryText}"
                       Classes="mono tablekit-console-summary"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{CompiledBinding CommandPreviewText}" />
            <ToggleButton x:Name="TableKitConsoleToggle"
                          Grid.Column="2"
                          IsChecked="{CompiledBinding IsConsoleExpanded, Mode=TwoWay}"
                          Classes="secondary compact-action"
                          AutomationProperties.Name="{DynamicResource String.TableKit.ConsoleToggleAutomationName}">
              <TextBlock Text="{CompiledBinding ConsoleToggleText}" />
            </ToggleButton>
            <Button Grid.Column="3"
                    Command="{CompiledBinding CopyConsoleCommand}"
                    Classes="secondary compact-action"
                    AutomationProperties.Name="{DynamicResource String.TableKit.CopyConsoleAutomationName}">
              <TextBlock Text="{DynamicResource String.Common.Copy}" />
            </Button>
            <Button Grid.Column="4"
                    Command="{CompiledBinding ClearConsoleCommand}"
                    Classes="secondary compact-action"
                    AutomationProperties.Name="{DynamicResource String.TableKit.ClearConsoleAutomationName}">
              <TextBlock Text="{DynamicResource String.Common.ClearHistory}" />
            </Button>
          </Grid>
        </Border>
        <ListBox x:Name="TableKitConsoleList"
                 Grid.Row="1"
                 ItemsSource="{CompiledBinding ConsoleEntries}"
                 Classes="tablekit-console-list terminal-list"
                 IsVisible="False"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.AutomationId="tablekit.console">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TableKitConsoleEntryViewModel">
              <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="4" Margin="0,2">
                <TextBlock Text="[" Classes="terminal-line muted" />
                <TextBlock Grid.Column="1" Text="{CompiledBinding Time}" Classes="terminal-line muted" />
                <TextBlock Grid.Column="2" Text="]" Classes="terminal-line muted" />
                <TextBlock Grid.Column="3" Text="{CompiledBinding Level}" Classes="terminal-line outbound" />
                <TextBlock Grid.Column="4" Text="{CompiledBinding Message}" Classes="terminal-line" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>
