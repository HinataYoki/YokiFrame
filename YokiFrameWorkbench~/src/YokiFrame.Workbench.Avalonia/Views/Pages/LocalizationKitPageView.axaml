<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokiFrame.Workbench.Avalonia.ViewModels"
             xmlns:models="using:YokiFrame.Tooling.Application.Models.LocalizationKit"
             x:Class="YokiFrame.Workbench.Avalonia.Views.Pages.LocalizationKitPageView"
             x:DataType="vm:LocalizationKitPageViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <!-- 筛选栏固定高度，只承担过滤与环境信息 -->
    <Border Classes="localization-filterbar">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto,160,Auto,Auto,Auto" ColumnSpacing="10">
          <TextBox Text="{CompiledBinding SearchText, Mode=TwoWay}"
                   Classes="kit-input"
                   PlaceholderText="{DynamicResource String.LocalizationKit.SearchPlaceholder}"
                   AutomationProperties.Name="{DynamicResource String.LocalizationKit.SearchPlaceholder}" />
          <TextBlock Grid.Column="1"
                     Text="{DynamicResource String.LocalizationKit.LanguageFilter}"
                     Classes="localization-meta"
                     VerticalAlignment="Center" />
          <ComboBox x:Name="LocalizationLanguageFilter"
                    Grid.Column="2"
                    ItemsSource="{CompiledBinding LanguageOptions}"
                    SelectedItem="{CompiledBinding SelectedLanguage, Mode=TwoWay}"
                    Classes="kit-input"
                    PlaceholderText="{DynamicResource String.LocalizationKit.AllLanguages}"
                    AutomationProperties.Name="{DynamicResource String.LocalizationKit.LanguageFilter}" />
          <CheckBox Grid.Column="3"
                    Content="{DynamicResource String.LocalizationKit.MissingOnly}"
                    IsChecked="{CompiledBinding MissingOnly, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{DynamicResource String.LocalizationKit.MissingOnly}" />
          <Button Grid.Column="4"
                  Content="{DynamicResource String.Common.Refresh}"
                  Command="{CompiledBinding RefreshCommand}"
                  Classes="secondary compact-action"
                  AutomationProperties.Name="{DynamicResource String.Common.Refresh}" />
          <Button Grid.Column="5"
                  Content="{DynamicResource String.LocalizationKit.CreateTemplate}"
                  Command="{CompiledBinding CreateTemplateCommand}"
                  Classes="secondary compact-action"
                  AutomationProperties.Name="{DynamicResource String.LocalizationKit.CreateTemplate}" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Text="{DynamicResource String.LocalizationKit.LubanWorkDir}"
                     Classes="localization-meta"
                     VerticalAlignment="Center" />
          <TextBox x:Name="LocalizationLubanWorkDir"
                   Grid.Column="1"
                   Text="{CompiledBinding LubanWorkDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Classes="kit-input"
                   PlaceholderText="{DynamicResource String.LocalizationKit.LubanWorkDirPlaceholder}"
                   ToolTip.Tip="{DynamicResource String.LocalizationKit.LubanWorkDir}"
                   AutomationProperties.Name="{DynamicResource String.LocalizationKit.LubanWorkDir}" />
          <Button Grid.Column="2"
                  Command="{CompiledBinding BrowseLubanWorkDirCommand}"
                  Classes="secondary compact-action"
                  ToolTip.Tip="{DynamicResource String.LocalizationKit.LubanWorkDir}"
                  AutomationProperties.Name="{DynamicResource String.LocalizationKit.LubanWorkDir}">
            <PathIcon Data="{StaticResource Icon.Folder}" Width="13" Height="13" />
          </Button>
          <Button Grid.Column="3"
                  Command="{CompiledBinding OpenExcelDirectoryCommand}"
                  Classes="secondary compact-action"
                  ToolTip.Tip="{DynamicResource String.LocalizationKit.ExcelDirectory}"
                  AutomationProperties.Name="{DynamicResource String.LocalizationKit.ExcelDirectory}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.Folder}" Width="13" Height="13" />
              <TextBlock Text="{DynamicResource String.LocalizationKit.ExcelDirectory}" />
            </StackPanel>
          </Button>
        </Grid>
      </Grid>
    </Border>

    <!-- 27/50/23 比例三窗格，支持横向扫描与深度提取 -->
    <Grid x:Name="LocalizationWorkspace" Grid.Row="1" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="27*" MinWidth="220" MaxWidth="320" />
        <ColumnDefinition Width="50*" MinWidth="460" />
        <ColumnDefinition Width="23*" MinWidth="200" MaxWidth="280" />
      </Grid.ColumnDefinitions>

      <Border Classes="panel" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <Border Classes="localization-pane-header">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <StackPanel Spacing="2">
                <TextBlock Text="{DynamicResource String.LocalizationKit.EntryIndex}" Classes="localization-pane-title" />
                <TextBlock Text="{DynamicResource String.LocalizationKit.EntryIndexSubtitle}" Classes="localization-meta" />
              </StackPanel>
              <Border Grid.Column="1" Classes="badge" Padding="8,4" VerticalAlignment="Center">
                <TextBlock Text="{CompiledBinding Entries.Count}"
                           Classes="mono"
                           FontSize="{DynamicResource FontSize.Sm}" />
              </Border>
            </Grid>
          </Border>
          <ListBox x:Name="LocalizationEntryList"
                   Grid.Row="1"
                   Classes="localization-entry-list kit-selection-list"
                   ItemsSource="{CompiledBinding Entries}"
                   SelectedItem="{CompiledBinding SelectedEntry, Mode=TwoWay}"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="{DynamicResource String.LocalizationKit.EntryIndex}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:LocalizationEntryRecord">
                <Border Classes="localization-entry-row">
                  <Grid ColumnDefinitions="58,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{CompiledBinding Id}"
                               Classes="mono localization-meta"
                               VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="4" MinWidth="0">
                      <TextBlock Text="{CompiledBinding Key}"
                                 Classes="localization-key"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{CompiledBinding Key}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{CompiledBinding Values.Count, StringFormat='{}Text {0}'}"
                                   Classes="localization-meta" />
                        <TextBlock Text="{DynamicResource String.LocalizationKit.Plural}"
                                   Classes="localization-meta"
                                   IsVisible="{CompiledBinding HasPlural}" />
                      </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="2"
                            Classes="localization-state missing"
                            IsVisible="{CompiledBinding HasMissing}">
                      <TextBlock Text="{CompiledBinding MissingLanguages.Count, StringFormat='{}Missing {0}'}" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="1"
                      IsVisible="{CompiledBinding IsEmpty}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="8"
                      Margin="20">
            <TextBlock Text="{CompiledBinding EmptyTitleText}"
                       Classes="localization-pane-title"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
            <TextBlock Text="{CompiledBinding EmptyHintText}"
                       Classes="localization-meta"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
              <Button Content="{DynamicResource String.LocalizationKit.ClearFilter}"
                      Command="{CompiledBinding ClearFiltersCommand}"
                      Classes="secondary compact-action"
                      IsVisible="{CompiledBinding HasActiveFilters}"
                       AutomationProperties.Name="{DynamicResource String.LocalizationKit.ClearFilter}" />
              <Button Content="{DynamicResource String.Common.Refresh}"
                      Command="{CompiledBinding RefreshCommand}"
                      Classes="secondary compact-action"
                      IsVisible="{CompiledBinding HasLoadError}"
                       AutomationProperties.Name="{DynamicResource String.Common.Refresh}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="panel" Padding="0">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <Border Classes="localization-pane-header">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <StackPanel Spacing="3" MinWidth="0">
                <TextBlock Text="{DynamicResource String.LocalizationKit.Translations}" Classes="localization-pane-title" />
                <TextBlock Text="{CompiledBinding SelectedEntry.Key, StringFormat='{}{0}'}"
                           Classes="localization-key"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{CompiledBinding SelectedEntry.Key}"
                           IsVisible="{CompiledBinding HasSelection}" />
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Text="{CompiledBinding SelectedEntry.Id, StringFormat='ID {0}'}"
                         Classes="mono localization-meta"
                         VerticalAlignment="Center"
                         IsVisible="{CompiledBinding HasSelection}" />
            </Grid>
          </Border>
          <Border Grid.Row="1" Classes="localization-summary">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="{CompiledBinding SelectedEntryMissingText}"
                         Classes="localization-meta"
                         TextWrapping="Wrap" />
              <TextBlock Grid.Column="1"
                         Text="{CompiledBinding SelectedEntry.HasPlural, StringFormat='Plural: {0}'}"
                         Classes="localization-meta"
                         VerticalAlignment="Center"
                         IsVisible="{CompiledBinding HasSelection}" />
            </Grid>
          </Border>
          <Border Grid.Row="2" Classes="localization-column-header">
            <Grid ColumnDefinitions="150,*,76" ColumnSpacing="10">
              <TextBlock Text="{DynamicResource String.LocalizationKit.Language}" Classes="localization-meta" />
              <TextBlock Grid.Column="1" Text="{DynamicResource String.LocalizationKit.TranslationPreview}" Classes="localization-meta" />
              <TextBlock Grid.Column="2" Text="{DynamicResource String.LocalizationKit.Status}" Classes="localization-meta" TextAlignment="Right" />
            </Grid>
          </Border>
          <Grid Grid.Row="3">
            <ScrollViewer x:Name="LocalizationValueScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{CompiledBinding HasSelection}">
              <ItemsControl Classes="localization-value-list" ItemsSource="{CompiledBinding SelectedValueRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LocalizationPreviewValueViewModel">
                    <Border Classes="localization-value-row kit-data-row" Classes.missing="{CompiledBinding IsMissing}">
                      <Grid ColumnDefinitions="150,*,76" ColumnSpacing="10">
                        <TextBlock Text="{CompiledBinding Language}"
                                   Classes="mono localization-language"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{CompiledBinding Language}"
                                   VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4" MinWidth="0">
                          <TextBlock Text="{CompiledBinding Value}"
                                     Classes="localization-translation"
                                     TextWrapping="Wrap"
                                     ToolTip.Tip="{CompiledBinding Value}" />
                          <TextBlock Text="{CompiledBinding PluralValue}"
                                     Classes="mono localization-meta"
                                     TextWrapping="Wrap"
                                     ToolTip.Tip="{CompiledBinding PluralValue}"
                                     IsVisible="{CompiledBinding HasPlural}" />
                        </StackPanel>
                        <Border Grid.Column="2"
                                Classes="localization-state missing"
                                IsVisible="{CompiledBinding IsMissing}">
                          <TextBlock Text="{DynamicResource String.LocalizationKit.Missing}" />
                        </Border>
                        <Border Grid.Column="2"
                                Classes="localization-state complete"
                                IsVisible="{CompiledBinding IsComplete}">
                          <TextBlock Text="{CompiledBinding StateText}" />
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <StackPanel IsVisible="{CompiledBinding HasNoSelection}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Margin="20">
              <TextBlock Text="{DynamicResource String.LocalizationKit.SelectEntry}"
                         Classes="localization-pane-title"
                         HorizontalAlignment="Center" />
              <TextBlock Text="{DynamicResource String.LocalizationKit.SelectEntryHint}"
                         Classes="localization-meta"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="panel" Padding="0">
        <Grid RowDefinitions="Auto,Auto,*">
          <Border Classes="localization-pane-header">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <StackPanel Spacing="2">
                <TextBlock Text="{DynamicResource String.LocalizationKit.LanguageCoverage}" Classes="localization-pane-title" />
                <TextBlock Text="{DynamicResource String.LocalizationKit.AllLanguagesSummary}" Classes="localization-meta" />
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Text="{CompiledBinding LanguageCoverage.Count}"
                         Classes="mono localization-meta"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Grid.Row="1" Classes="localization-coverage-summary">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource String.LocalizationKit.CurrentEntry}" Classes="localization-meta" />
              <TextBlock Text="{CompiledBinding SelectedEntryMissingText}"
                         Classes="localization-language"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <ScrollViewer x:Name="LocalizationCoverageScroll"
                        Grid.Row="2"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Classes="localization-coverage-list" ItemsSource="{CompiledBinding LanguageCoverage}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LocalizationLanguageCoverageViewModel">
                  <Border Classes="localization-coverage-row kit-data-row" Classes.missing="{CompiledBinding HasMissing}">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8" RowSpacing="8">
                      <StackPanel Spacing="3" MinWidth="0">
                        <TextBlock Text="{CompiledBinding Language}"
                                   Classes="localization-language"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{CompiledBinding Language}" />
                        <TextBlock Text="{CompiledBinding StateText}"
                                   Classes="localization-meta" />
                      </StackPanel>
                      <TextBlock Grid.Column="1"
                                 Text="{CompiledBinding CoverageText}"
                                 Classes="mono localization-language"
                                 VerticalAlignment="Top" />
                      <ProgressBar Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Classes="localization-coverage-progress"
                                   Classes.missing="{CompiledBinding HasMissing}"
                                   Minimum="0"
                                   Maximum="100"
                                   Value="{CompiledBinding CoveragePercent}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
