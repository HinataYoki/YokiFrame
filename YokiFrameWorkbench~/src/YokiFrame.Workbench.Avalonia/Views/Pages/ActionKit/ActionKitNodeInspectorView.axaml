<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokiFrame.Workbench.Avalonia.ViewModels"
             xmlns:components="using:YokiFrame.Workbench.Avalonia.Components"
             x:Class="YokiFrame.Workbench.Avalonia.Views.Pages.ActionKit.ActionKitNodeInspectorView"
             x:DataType="vm:ActionKitPageViewModel"
             ClipToBounds="True">
  <Grid>
    <StackPanel IsVisible="{CompiledBinding !HasSelection}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Margin="20">
      <components:NavigationIcon IconKey="actionkit" Width="24" Height="24" />
      <TextBlock Text="选择一个动作节点"
                 FontWeight="SemiBold"
                 HorizontalAlignment="Center" />
      <TextBlock Text="节点状态、执行器和完整诊断摘要将在这里显示。"
                 Classes="actionkit-empty-text"
                 TextAlignment="Center"
                 TextWrapping="Wrap" />
    </StackPanel>

    <Grid IsVisible="{CompiledBinding HasSelection}">
      <Grid Classes="actionkit-inspector-vertical"
            RowDefinitions="Auto,Auto,*">
        <Border Classes="actionkit-inspector-header">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Spacing="3">
              <TextBlock Text="节点详情" Classes="actionkit-section-title" />
              <TextBlock Text="{CompiledBinding SelectedActionId, StringFormat=\#{0}}"
                         Classes="mono actionkit-caption"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{CompiledBinding SelectedActionId}" />
            </StackPanel>
            <Border Grid.Column="1"
                    Classes="actionkit-state-badge"
                    VerticalAlignment="Center">
              <TextBlock Text="{CompiledBinding SelectedActionStatus}" />
            </Border>
          </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="12"
              ColumnDefinitions="72,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="10"
              RowSpacing="8">
          <TextBlock Text="类型" Classes="actionkit-detail-label" />
          <TextBlock Grid.Column="1" Text="{CompiledBinding SelectedActionType}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Row="1" Text="执行器" Classes="actionkit-detail-label" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{CompiledBinding SelectedNode.ExecutorName}" Classes="mono" TextTrimming="CharacterEllipsis" ToolTip.Tip="{CompiledBinding SelectedNode.ExecutorName}" />
          <TextBlock Grid.Row="2" Text="更新模式" Classes="actionkit-detail-label" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{CompiledBinding SelectedNode.UpdateMode}" Classes="mono" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Row="3" Text="进度" Classes="actionkit-detail-label" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{CompiledBinding SelectedNode.ProgressLabelText}" Classes="mono" />
          <TextBlock Grid.Row="4" Text="深度" Classes="actionkit-detail-label" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{CompiledBinding SelectedNode.Depth, StringFormat=L{0}}" Classes="mono" />
        </Grid>

        <Border Grid.Row="2" Classes="actionkit-debug-card" Margin="12,0,12,12">
          <StackPanel Spacing="6">
            <TextBlock Text="诊断摘要" Classes="actionkit-detail-label" />
            <TextBlock Text="{CompiledBinding SelectedDebugInfo}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="8" ToolTip.Tip="{CompiledBinding SelectedDebugInfo}" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid Classes="actionkit-inspector-horizontal"
            RowDefinitions="Auto,Auto,*">
        <Border Classes="actionkit-inspector-header compact">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="节点详情" Classes="actionkit-section-title" />
              <TextBlock Text="{CompiledBinding SelectedActionId, StringFormat=\#{0}}" Classes="mono actionkit-caption" />
            </StackPanel>
            <Border Grid.Column="1" Classes="actionkit-state-badge" VerticalAlignment="Center">
              <TextBlock Text="{CompiledBinding SelectedActionStatus}" />
            </Border>
          </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="5" Margin="12,7">
          <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="类型" Classes="actionkit-detail-label" /><TextBlock Text="{CompiledBinding SelectedActionType}" FontWeight="SemiBold" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="执行器" Classes="actionkit-detail-label" /><TextBlock Text="{CompiledBinding SelectedNode.ExecutorName}" Classes="mono" TextTrimming="CharacterEllipsis" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="更新" Classes="actionkit-detail-label" /><TextBlock Text="{CompiledBinding SelectedNode.UpdateMode}" Classes="mono" TextTrimming="CharacterEllipsis" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="进度" Classes="actionkit-detail-label" /><TextBlock Text="{CompiledBinding SelectedNode.ProgressLabelText}" Classes="mono" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="深度" Classes="actionkit-detail-label" /><TextBlock Text="{CompiledBinding SelectedNode.Depth, StringFormat=L{0}}" Classes="mono" /></StackPanel>
        </UniformGrid>

        <Border Grid.Row="2" Classes="actionkit-debug-card" Margin="12,0,12,10">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <TextBlock Text="诊断摘要" Classes="actionkit-detail-label" />
            <TextBlock Grid.Column="1" Text="{CompiledBinding SelectedDebugInfo}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="3" ToolTip.Tip="{CompiledBinding SelectedDebugInfo}" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
