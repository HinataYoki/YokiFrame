<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:YokiFrame.Workbench.Avalonia.Components"
             xmlns:vm="using:YokiFrame.Workbench.Avalonia.ViewModels"
             xmlns:pool="using:YokiFrame.Workbench.Avalonia.ViewModels.PoolKit"
             xmlns:poolModel="using:YokiFrame.Tooling.Application.Models.PoolKit"
             x:Class="YokiFrame.Workbench.Avalonia.Views.Pages.PoolKitPageView"
             x:DataType="vm:PoolKitPageViewModel"
             AutomationProperties.AutomationId="workbench.poolkit.page">
  <Grid RowDefinitions="*,Auto">
    <Grid x:Name="PoolKitWorkspace">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" MinWidth="280" MaxWidth="420" />
        <ColumnDefinition Width="9" />
        <ColumnDefinition Width="*" MinWidth="520" />
      </Grid.ColumnDefinitions>

      <Border x:Name="PoolMasterPanel"
              Classes="panel poolkit-master-panel"
              Padding="0">
        <Grid RowDefinitions="Auto,Auto,*">
          <Border Classes="kit-panel-header poolkit-master-header">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">
              <StackPanel Orientation="Horizontal"
                          Spacing="7"
                          VerticalAlignment="Center">
                <components:NavigationIcon IconKey="poolkit" Width="15" Height="15" />
                <TextBlock Text="{DynamicResource String.PoolKit.Pools}"
                           Classes="poolkit-section-title" />
              </StackPanel>
              <Border Grid.Column="1"
                      Classes="badge accent"
                      Padding="9,3"
                      VerticalAlignment="Center">
                <TextBlock Text="{CompiledBinding VisibleCountText}"
                           Classes="mono poolkit-caption" />
              </Border>
            </Grid>
          </Border>

          <TextBox Grid.Row="1"
                   Margin="12,10"
                   Text="{CompiledBinding SearchText, Mode=TwoWay}"
                   PlaceholderText="{DynamicResource String.PoolKit.SearchPlaceholder}"
                   AutomationProperties.Name="{DynamicResource String.PoolKit.SearchAutomationName}"
                   AutomationProperties.AutomationId="workbench.poolkit.search" />

          <Grid Grid.Row="2"
                Margin="8,0,4,8">
            <ListBox x:Name="PoolList"
                     Classes="poolkit-pool-list kit-selection-list"
                     ItemsSource="{CompiledBinding Pools}"
                     SelectedItem="{CompiledBinding SelectedPool, Mode=TwoWay}"
                     Padding="0,0,12,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="{DynamicResource String.PoolKit.PoolsAutomationName}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="pool:PoolKitPoolListItemViewModel">
                  <Grid RowDefinitions="Auto,Auto"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="8"
                        RowSpacing="3">
                    <TextBlock Text="{CompiledBinding Name}"
                               Classes="poolkit-pool-name"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{CompiledBinding Name}" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource Icon.TriangleAlert}"
                                Width="13"
                                Height="13"
                                Classes="poolkit-warning-icon"
                                IsVisible="{CompiledBinding IsLeakCandidate}"
                                ToolTip.Tip="{DynamicResource String.PoolKit.SuspectedLeakTooltip}" />
                      <TextBlock Text="{CompiledBinding UsagePercentText}"
                                 Classes="mono poolkit-pool-usage"
                                 Classes.warning="{CompiledBinding IsHighPressure}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1"
                               Text="{CompiledBinding TypeName}"
                               Classes="mono poolkit-caption"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{CompiledBinding TypeName}" />
                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                HorizontalAlignment="Right">
                      <Border Classes="poolkit-recent-event"
                              IsVisible="{CompiledBinding HasRecentEvent}">
                        <TextBlock Text="{CompiledBinding RecentEventText}"
                                   Classes="poolkit-caption" />
                      </Border>
                      <TextBlock Classes="mono poolkit-caption">
                        <Run Text="{CompiledBinding ActiveCount}" />
                        <Run Text="/" />
                        <Run Text="{CompiledBinding TotalCount}" />
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        IsVisible="{CompiledBinding IsWaitingForData}">
              <ProgressBar Width="120"
                           Height="4"
                           IsIndeterminate="True" />
              <TextBlock Text="{DynamicResource String.PoolKit.WaitingConnection}"
                         Classes="poolkit-empty-text" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Margin="24"
                        IsVisible="{CompiledBinding HasNoRuntimePools}">
              <components:NavigationIcon IconKey="poolkit" Width="24" Height="24" />
              <TextBlock Text="{DynamicResource String.PoolKit.NoRuntimePools}"
                         FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource String.PoolKit.NoRuntimePoolsHint}"
                         Classes="poolkit-empty-text"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="7"
                        Margin="24"
                        IsVisible="{CompiledBinding HasNoSearchResults}">
              <TextBlock Text="{CompiledBinding SearchEmptyText}"
                         Classes="poolkit-empty-text"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Classes="poolkit-master-splitter"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    Cursor="SizeWestEast" />
      <Border x:Name="PoolDetailPanel"
              Grid.Column="2"
              Classes="panel poolkit-detail-panel"
              Padding="0">
        <Grid>
          <Border Classes="kit-empty-state poolkit-detail-empty"
                  Margin="12"
                  IsVisible="{CompiledBinding IsSelectionEmpty}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
              <components:NavigationIcon IconKey="poolkit" Width="24" Height="24" />
              <TextBlock Text="{DynamicResource String.PoolKit.SelectAPool}"
                         FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource String.PoolKit.SelectAPoolHint}"
                         Classes="poolkit-empty-text"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Grid IsVisible="{CompiledBinding HasSelection}"
                RowDefinitions="Auto,*,Auto">
            <Border Classes="poolkit-detail-header">
              <Grid RowDefinitions="Auto,10,Auto,8,Auto">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{CompiledBinding SelectedName}"
                               Classes="poolkit-detail-title"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{CompiledBinding SelectedName}" />
                    <TextBlock Text="{CompiledBinding SelectedTypeName}"
                               Classes="mono poolkit-caption"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{CompiledBinding SelectedTypeName}" />
                  </StackPanel>
                  <Border Grid.Column="1"
                          Classes="poolkit-leak-candidate"
                          IsVisible="{CompiledBinding SelectedIsLeakCandidate}"
                          ToolTip.Tip="{CompiledBinding LeakWarningText}"
                          VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                      <PathIcon Data="{StaticResource Icon.TriangleAlert}"
                                Width="13"
                                Height="13" />
                      <TextBlock Text="{DynamicResource String.PoolKit.SuspectedLeak}"
                                 FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid Grid.Row="2"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                  <ProgressBar Classes="poolkit-usage large"
                               Classes.warning="{CompiledBinding SelectedIsHighPressure}"
                               Minimum="0"
                               Maximum="100"
                               Value="{CompiledBinding SelectedUsagePercent}"
                               VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1"
                             Text="{CompiledBinding SelectedUsagePercentText}"
                             Classes="mono poolkit-pressure-value"
                             VerticalAlignment="Center" />
                </Grid>

                <Border Grid.Row="4"
                        Classes="poolkit-metric-strip">
                  <Grid ColumnDefinitions="*,*,*,*,*">
                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                      <TextBlock Text="{DynamicResource String.PoolKit.ActiveCount}" Classes="poolkit-metric-label" />
                      <TextBlock Text="{CompiledBinding SelectedActiveCount}" Classes="mono poolkit-metric-value" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                      <TextBlock Text="{DynamicResource String.PoolKit.InactiveCount}" Classes="poolkit-metric-label" />
                      <TextBlock Text="{CompiledBinding SelectedInactiveCount}" Classes="mono poolkit-metric-value" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                      <TextBlock Text="{DynamicResource String.PoolKit.Capacity}" Classes="poolkit-metric-label" />
                      <TextBlock Text="{CompiledBinding SelectedTotalCount}" Classes="mono poolkit-metric-value" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                      <TextBlock Text="{DynamicResource String.PoolKit.Peak}" Classes="poolkit-metric-label" />
                      <TextBlock Text="{CompiledBinding SelectedPeakCount}" Classes="mono poolkit-metric-value" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                      <TextBlock Text="{DynamicResource String.PoolKit.MaxLimit}" Classes="poolkit-metric-label" />
                      <TextBlock Text="{CompiledBinding SelectedMaxCacheCountText}" Classes="mono poolkit-metric-value" />
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </Border>
            <TabControl x:Name="ObjectTabs"
                        Grid.Row="1"
                        Classes="poolkit-object-tabs"
                        Margin="12,0,12,8">
              <TabItem Classes="poolkit-object-tab">
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="{DynamicResource String.PoolKit.ActiveObjects}" />
                    <TextBlock Text="{CompiledBinding SelectedActiveObjectCountText}"
                               Classes="mono poolkit-tab-count" />
                  </StackPanel>
                </TabItem.Header>
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="poolkit-table-header">
                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="140" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="3*" MinWidth="220" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{DynamicResource String.PoolKit.Object}" />
                      <TextBlock Grid.Column="1" Text="{DynamicResource String.PoolKit.SpawnTime}" />
                      <TextBlock Grid.Column="2" Text="{DynamicResource String.PoolKit.SourceLocation}" />
                    </Grid>
                  </Border>
                  <ListBox Grid.Row="1"
                           Classes="poolkit-object-list kit-data-list"
                           ItemsSource="{CompiledBinding SelectedActiveObjects}"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical" />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="pool:PoolKitObjectListItemViewModel">
                        <Grid ColumnSpacing="10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="140" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="3*" MinWidth="220" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{CompiledBinding ObjectName}"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{CompiledBinding ObjectName}" />
                          <TextBlock Grid.Column="1"
                                     Text="{CompiledBinding SpawnTime, StringFormat={}{0:F2}s}"
                                     Classes="mono poolkit-caption" />
                          <Button Grid.Column="2"
                                  Command="{CompiledBinding OpenCommand}"
                                  Classes="ghost poolkit-source-link"
                                  ToolTip.Tip="{CompiledBinding FullSourceText}"
                                  AutomationProperties.Name="{CompiledBinding OpenAutomationName}"
                                  IsVisible="{CompiledBinding HasSourceLocation}">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="6">
                              <TextBlock Text="{CompiledBinding SourceDisplay}"
                                         Classes="mono poolkit-caption"
                                         TextTrimming="CharacterEllipsis" />
                              <PathIcon Grid.Column="1"
                                        Data="{StaticResource Icon.Code2}"
                                        Width="13"
                                        Height="13" />
                            </Grid>
                          </Button>
                          <TextBlock Grid.Column="2"
                                     Text="{DynamicResource String.PoolKit.NoSourceLocation}"
                                     Classes="poolkit-caption"
                                     IsVisible="{CompiledBinding !HasSourceLocation}" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Grid.Row="1"
                             Text="{DynamicResource String.PoolKit.NoActiveObjects}"
                             Classes="poolkit-empty-text"
                             IsVisible="{CompiledBinding SelectedActiveObjectsEmpty}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Grid>
              </TabItem>
              <TabItem Classes="poolkit-object-tab">
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="{DynamicResource String.PoolKit.InactiveObjects}" />
                    <TextBlock Text="{CompiledBinding SelectedInactiveObjectCountText}"
                               Classes="mono poolkit-tab-count" />
                  </StackPanel>
                </TabItem.Header>
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="poolkit-table-header">
                    <Grid ColumnDefinitions="*,100"
                          ColumnSpacing="10">
                      <TextBlock Text="{DynamicResource String.PoolKit.Object}" />
                      <TextBlock Grid.Column="1" Text="{DynamicResource String.Common.State}" />
                    </Grid>
                  </Border>
                  <ListBox Grid.Row="1"
                           Classes="poolkit-object-list kit-data-list"
                           ItemsSource="{CompiledBinding SelectedInactiveObjects}"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical" />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="poolModel:WorkbenchPoolKitObject">
                        <Grid ColumnDefinitions="*,100"
                              ColumnSpacing="10">
                          <TextBlock Text="{CompiledBinding ObjectName}"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{CompiledBinding ObjectName}" />
                          <TextBlock Grid.Column="1"
                                     Text="{DynamicResource String.PoolKit.Available}"
                                     Classes="poolkit-available" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Grid.Row="1"
                             Text="{DynamicResource String.PoolKit.NoInactiveObjects}"
                             Classes="poolkit-empty-text"
                             IsVisible="{CompiledBinding SelectedInactiveObjectsEmpty}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Grid>
              </TabItem>
            </TabControl>
            <Expander x:Name="EventDrawer"
                      Grid.Row="2"
                      Classes="poolkit-event-drawer"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      IsExpanded="True">
              <Expander.Header>
                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="10">
                  <TextBlock Text="{DynamicResource String.PoolKit.EventStream}"
                             FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1"
                             Text="{CompiledBinding SelectedEventCountText}"
                             Classes="mono poolkit-caption" />
                  <TextBlock Grid.Column="2"
                             Text="{DynamicResource String.PoolKit.EventsTruncated}"
                             Classes="poolkit-warning-text"
                             IsVisible="{CompiledBinding EventsTruncated}" />
                </Grid>
              </Expander.Header>
              <Grid MinHeight="120"
                    MaxHeight="230">
                <ListBox Classes="poolkit-event-list kit-timeline-list"
                         ItemsSource="{CompiledBinding Events}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="{DynamicResource String.PoolKit.EventStreamAutomationName}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="pool:PoolKitEventListItemViewModel">
                      <Grid ColumnDefinitions="76,*,76,180"
                            ColumnSpacing="10">
                        <Border Classes="poolkit-event-kind"
                                Classes.spawn="{CompiledBinding IsSpawn}"
                                Classes.return="{CompiledBinding IsReturn}"
                                Classes.forced="{CompiledBinding IsForced}">
                          <TextBlock Text="{CompiledBinding EventTypeText}"
                                     FontWeight="SemiBold"
                                     TextAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{CompiledBinding ObjectName}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{CompiledBinding ObjectName}" />
                        <TextBlock Grid.Column="2"
                                   Text="{CompiledBinding TimeText}"
                                   Classes="mono poolkit-caption" />
                        <TextBlock Grid.Column="3"
                                   Text="{CompiledBinding SourceText}"
                                   Classes="mono poolkit-caption"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{CompiledBinding SourceText}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{DynamicResource String.PoolKit.NoEvents}"
                           Classes="poolkit-empty-text"
                           IsVisible="{CompiledBinding IsEventEmpty}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Grid>
            </Expander>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="1"
            Classes="poolkit-status-footer">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto"
            ColumnSpacing="14">
        <TextBlock Classes="poolkit-footer-item">
          <Run Text="{DynamicResource String.PoolKit.Pools}" />
          <Run Text=": " />
          <Run Text="{CompiledBinding PoolTotal}" FontWeight="SemiBold" />
        </TextBlock>
        <TextBlock Grid.Column="1" Classes="poolkit-footer-item">
          <Run Text="{DynamicResource String.PoolKit.GlobalActive}" />
          <Run Text=": " />
          <Run Text="{CompiledBinding TotalActive}" FontWeight="SemiBold" />
        </TextBlock>
        <TextBlock Grid.Column="2" Classes="poolkit-footer-item">
          <Run Text="{DynamicResource String.PoolKit.CandidatePools}" />
          <Run Text=": " />
          <Run Text="{CompiledBinding LeakCount}" FontWeight="SemiBold" />
        </TextBlock>
        <StackPanel Grid.Column="3"
                    Orientation="Horizontal"
                    Spacing="8">
          <TextBlock Text="{CompiledBinding OperationStatusText}"
                     Classes="poolkit-footer-item"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{CompiledBinding OperationStatusText}" />
          <TextBlock Text="{DynamicResource String.PoolKit.LeaksTruncated}"
                     Classes="poolkit-warning-text"
                     IsVisible="{CompiledBinding LeaksTruncated}" />
          <TextBlock Text="{CompiledBinding StaleReason}"
                     Classes="poolkit-warning-text"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{CompiledBinding StaleReason}" />
        </StackPanel>
        <TextBlock Grid.Column="4"
                   Text="{CompiledBinding Source}"
                   Classes="mono poolkit-footer-item" />
        <TextBlock Grid.Column="5"
                   Text="{CompiledBinding TrackingStatusText}"
                   Classes="poolkit-footer-item" />
        <TextBlock Grid.Column="6"
                   Text="{CompiledBinding LocationStatusText}"
                   Classes="poolkit-footer-item" />
        <TextBlock Grid.Column="7"
                   Text="{CompiledBinding EventHistoryStatusText}"
                   Classes="poolkit-footer-item" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
