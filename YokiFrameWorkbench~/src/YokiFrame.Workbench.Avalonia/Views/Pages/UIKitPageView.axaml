<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="using:YokiFrame.Tooling.Application.Models.UIKit"
             xmlns:pages="using:YokiFrame.Workbench.Avalonia.Views.Pages"
             xmlns:converters="using:YokiFrame.Workbench.Avalonia.Converters"
             xmlns:vm="using:YokiFrame.Workbench.Avalonia.ViewModels"
             x:Class="YokiFrame.Workbench.Avalonia.Views.Pages.UIKitPageView"
             x:DataType="vm:UIKitPageViewModel"
             Classes="uikit-page"
             SizeChanged="OnPageSizeChanged"
             ToolTip.ShowDelay="300"
             AutomationProperties.AutomationId="workbench.uikit.page">
  <UserControl.Resources>
    <converters:UIKitDisplayTextConverter x:Key="UIKitDisplayText" />
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="9">
    <Border Classes="kit-panel uikit-task-strip">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Command="{CompiledBinding ShowRuntimeTaskCommand}"
                  Classes="uikit-task-button"
                  Classes.active="{CompiledBinding IsRuntimeTask}"
                  AutomationProperties.Name="{DynamicResource String.UIKit.RuntimeDiagnostics}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.Eye}"
                        Width="13" Height="13"
                        Foreground="{DynamicResource Brush.Icon.UIKit}" />
              <TextBlock Text="{DynamicResource String.UIKit.RuntimeDiagnostics}" Classes="uikit-task-text" />
            </StackPanel>
          </Button>
          <Button Command="{CompiledBinding ShowEditorToolsTaskCommand}"
                  Classes="uikit-task-button"
                  Classes.active="{CompiledBinding IsEditorToolsTask}"
                  AutomationProperties.Name="{DynamicResource String.UIKit.EditorTools}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.Navigation.UIKit}" Width="13" Height="13"
                        Foreground="{DynamicResource Brush.Icon.UIKit}" />
              <TextBlock Text="{DynamicResource String.UIKit.EditorTools}" Classes="uikit-task-text" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                    IsVisible="{CompiledBinding IsRuntimeTask}">
          <TextBlock Text="{CompiledBinding CopyStatusText}"
                     IsVisible="{CompiledBinding HasCopyStatus}"
                     Classes="uikit-caption"
                     MaxWidth="160"
                     TextTrimming="CharacterEllipsis"
                     AutomationProperties.LiveSetting="Polite" />
          <Button Command="{CompiledBinding CopySnapshotCommand}"
                  Classes="secondary icon-button"
                  ToolTip.Tip="{DynamicResource String.Common.Copy}"
                  AutomationProperties.Name="{DynamicResource String.Common.Copy}">
            <PathIcon Data="{StaticResource Icon.Copy}" Width="14" Height="14" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="6"
          IsVisible="{CompiledBinding IsRuntimeTask}">
      <Border Classes="kit-status uikit-status-strip">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
          <Border Classes="uikit-chip"
                  Classes.positive="{CompiledBinding RootExists}"
                  Classes.warning="{CompiledBinding RootMissing}">
            <TextBlock Text="{CompiledBinding RootStatusText}" Classes="uikit-chip-text" />
          </Border>
          <Border Grid.Column="1" Classes="uikit-chip">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="{DynamicResource String.Common.DataSource}" Classes="uikit-label" />
              <TextBlock Text="{CompiledBinding Source}" Classes="mono uikit-chip-text" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="uikit-chip">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="{DynamicResource String.Common.UpdateTime}" Classes="uikit-label" />
              <TextBlock Text="{CompiledBinding UpdatedAtText}" Classes="mono uikit-chip-text" />
            </StackPanel>
          </Border>
          <TextBlock Grid.Column="4" Text="{CompiledBinding CoverageText}"
                     Classes="mono uikit-caption"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>
      <Border Grid.Row="1" Classes="uikit-stale-banner"
              IsVisible="{CompiledBinding HasStaleReason}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <PathIcon Data="{StaticResource Icon.TriangleAlert}"
                    Width="14" Height="14"
                    Foreground="{DynamicResource Brush.Status.WarningText}"
                    VerticalAlignment="Top" />
          <TextBlock Grid.Column="1" Text="{CompiledBinding StaleReason}"
                     Foreground="{DynamicResource Brush.Status.WarningText}"
                     TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="UIKitRuntimeLayout" Grid.Row="2" IsVisible="{CompiledBinding IsRuntimeTask}">
      <Grid x:Name="UIKitWideLayout"
            ColumnDefinitions="230,7,*,7,320"
            ColumnSpacing="0">
      <Border x:Name="UIKitMetricsPanel" Classes="kit-panel uikit-metrics-panel" Padding="0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Classes="uikit-metric-section">
              <StackPanel Spacing="7">
                <TextBlock Text="{DynamicResource String.UIKit.RuntimeOverview}" Classes="uikit-section-title" />
                <Grid Classes="uikit-metric-row" ColumnDefinitions="*,Auto">
                  <TextBlock Text="{DynamicResource String.UIKit.Panels}" Classes="uikit-label" />
                  <TextBlock Grid.Column="1" Text="{CompiledBinding PanelCount}" Classes="mono uikit-value" />
                </Grid>
                <Grid Classes="uikit-metric-row" ColumnDefinitions="*,Auto">
                  <TextBlock Text="{DynamicResource String.UIKit.NamedStacks}" Classes="uikit-label" />
                  <TextBlock Grid.Column="1" Text="{CompiledBinding StackCount}" Classes="mono uikit-value" />
                </Grid>
                <Grid Classes="uikit-metric-row" ColumnDefinitions="*,Auto">
                  <TextBlock Text="{DynamicResource String.UIKit.StackMembers}" Classes="uikit-label" />
                  <TextBlock Grid.Column="1" Text="{CompiledBinding StackMembershipCount}" Classes="mono uikit-value" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Classes="uikit-metric-section">
              <StackPanel Spacing="5">
                <TextBlock Text="{DynamicResource String.UIKit.Lifecycle}" Classes="uikit-section-title" Margin="0,0,0,2" />
                <Grid Classes="uikit-metric-row" ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource String.UIKit.State.Preloaded}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding PreloadedCount}" Classes="mono" /></Grid>
                <Grid Classes="uikit-metric-row" ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource String.UIKit.State.Opening}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding OpeningCount}" Classes="mono" /></Grid>
                <Grid Classes="uikit-metric-row" ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource String.UIKit.State.Open}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding OpenCount}" Classes="mono" /></Grid>
                <Grid Classes="uikit-metric-row" ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource String.UIKit.State.Hiding}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding HidingCount}" Classes="mono" /></Grid>
                <Grid Classes="uikit-metric-row" ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource String.UIKit.State.Hidden}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding HiddenCount}" Classes="mono" /></Grid>
                <Grid Classes="uikit-metric-row" ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource String.UIKit.State.Closing}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding ClosingCount}" Classes="mono" /></Grid>
                <Grid Classes="uikit-metric-row" ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource String.UIKit.State.Cached}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding CachedCount}" Classes="mono" /></Grid>
                <Grid Classes="uikit-metric-row" ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource String.UIKit.State.Closed}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding ClosedCount}" Classes="mono" /></Grid>
              </StackPanel>
            </Border>
            <Border Classes="uikit-metric-section">
              <StackPanel Spacing="5">
                <TextBlock Text="{DynamicResource String.UIKit.Cache}" Classes="uikit-section-title" Margin="0,0,0,2" />
                <Grid Classes="uikit-metric-row" ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource String.UIKit.Capacity}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding CacheCapacity}" Classes="mono" /></Grid>
                <Grid Classes="uikit-metric-row" ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource String.UIKit.Cache.Transient}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding TransientCount}" Classes="mono" /></Grid>
                <Grid Classes="uikit-metric-row" ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource String.UIKit.Cache.Reusable}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding ReusableCount}" Classes="mono" /></Grid>
                <Grid Classes="uikit-metric-row" ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource String.UIKit.Cache.ReusableCached}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding ReusableCachedCount}" Classes="mono" /></Grid>
                <Grid Classes="uikit-metric-row" ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource String.UIKit.Cache.Persistent}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding PersistentCount}" Classes="mono" /></Grid>
              </StackPanel>
            </Border>
            <Border Classes="uikit-metric-section" BorderThickness="0">
              <StackPanel Spacing="5">
                <TextBlock Text="{DynamicResource String.UIKit.Modal}" Classes="uikit-section-title" Margin="0,0,0,2" />
                <Grid Classes="uikit-metric-row" ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource String.UIKit.PanelCount}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding ModalPanelCount}" Classes="mono" /></Grid>
                <Grid Classes="uikit-metric-row" ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource String.UIKit.Blocker}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding ModalStatusText}" Classes="mono" /></Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <GridSplitter Grid.Column="1" Classes="uikit-splitter"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                    Background="Transparent"
                    AutomationProperties.Name="{DynamicResource String.UIKit.MetricCollectionSplitterAutomationName}" />

      <Border Grid.Column="2" Classes="kit-panel uikit-collection-panel" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <Border Classes="kit-panel-header uikit-collection-header">
            <Grid ColumnDefinitions="*,260" ColumnSpacing="10">
              <StackPanel Spacing="2">
                <TextBlock Text="{DynamicResource String.UIKit.RuntimeCollections}" Classes="uikit-section-title" />
                <TextBlock Text="{CompiledBinding CoverageText}" Classes="mono uikit-caption" />
              </StackPanel>
              <TextBox Grid.Column="1" Text="{CompiledBinding SearchText, Mode=TwoWay}"
                       PlaceholderText="{DynamicResource String.UIKit.SearchPlaceholder}"
                       AutomationProperties.Name="{DynamicResource String.UIKit.SearchPlaceholder}"
                       AutomationProperties.AutomationId="workbench.uikit.search" />
            </Grid>
          </Border>
          <TabControl Grid.Row="1" SelectedIndex="{CompiledBinding SelectedCollectionIndex, Mode=TwoWay}">
            <TabItem Header="{DynamicResource String.UIKit.Panels}" Classes="kit-tab uikit-tab">
              <Grid RowDefinitions="Auto,*,Auto">
                <Grid Margin="10,7" ColumnDefinitions="80,*,2*,90" ColumnSpacing="8">
                  <TextBlock Text="{DynamicResource String.Common.State}" Classes="uikit-label" />
                  <TextBlock Grid.Column="1" Text="{DynamicResource String.Common.Name}" Classes="uikit-label" />
                  <TextBlock Grid.Column="2" Text="{DynamicResource String.Common.Type}" Classes="uikit-label" />
                  <TextBlock Grid.Column="3" Text="{DynamicResource String.UIKit.Level}" Classes="uikit-label" />
                </Grid>
                <Grid Grid.Row="1">
                  <ListBox x:Name="UIKitWidePanelList" Classes="uikit-list kit-data-list"
                           ItemsSource="{CompiledBinding Panels}"
                           SelectedItem="{CompiledBinding SelectedPanel, Mode=TwoWay}"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           SelectionMode="Single"
                           AutomationProperties.Name="{DynamicResource String.UIKit.Panels}">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="model:WorkbenchUIKitPanel">
                        <Grid ColumnDefinitions="80,*,2*,90" ColumnSpacing="8">
                          <Border Classes="uikit-state-chip" HorizontalAlignment="Left">
                            <TextBlock Text="{CompiledBinding State, Converter={StaticResource UIKitDisplayText}, ConverterParameter=state}" Classes="uikit-chip-text" />
                          </Border>
                          <TextBlock Grid.Column="1" Text="{CompiledBinding Name}" Classes="mono" TextTrimming="CharacterEllipsis" ToolTip.Tip="{CompiledBinding Name}" />
                          <TextBlock Grid.Column="2" Text="{CompiledBinding Type}" Classes="mono uikit-caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{CompiledBinding Type}" />
                          <TextBlock Grid.Column="3" Text="{CompiledBinding Level, Converter={StaticResource UIKitDisplayText}, ConverterParameter=level}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Border Classes="kit-empty-state uikit-empty-state" IsVisible="{CompiledBinding IsEmpty}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7" MaxWidth="330">
                      <TextBlock Text="{CompiledBinding EmptyTitleText}" Classes="uikit-section-title" HorizontalAlignment="Center" />
                      <TextBlock Text="{CompiledBinding EmptyHintText}" Classes="uikit-caption" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Border Grid.Row="2" Classes="uikit-truncated-banner" IsVisible="{CompiledBinding PanelsTruncated}">
                  <TextBlock Text="{CompiledBinding CoverageText}" Foreground="{DynamicResource Brush.Status.WarningText}" />
                </Border>
              </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource String.UIKit.NamedStacks}" Classes="kit-tab uikit-tab">
              <Grid RowDefinitions="Auto,*,Auto">
                <Grid Margin="10,7" ColumnDefinitions="70,*,*,2*" ColumnSpacing="8">
                  <TextBlock Text="{DynamicResource String.UIKit.Depth}" Classes="uikit-label" />
                  <TextBlock Grid.Column="1" Text="{DynamicResource String.Common.Name}" Classes="uikit-label" />
                  <TextBlock Grid.Column="2" Text="{DynamicResource String.UIKit.TopPanelName}" Classes="uikit-label" />
                  <TextBlock Grid.Column="3" Text="{DynamicResource String.UIKit.TopPanelType}" Classes="uikit-label" />
                </Grid>
                <Grid Grid.Row="1">
                  <ListBox x:Name="UIKitWideStackList" Classes="uikit-list kit-data-list"
                           ItemsSource="{CompiledBinding Stacks}"
                           SelectedItem="{CompiledBinding SelectedStack, Mode=TwoWay}"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           SelectionMode="Single"
                            AutomationProperties.Name="{DynamicResource String.UIKit.NamedStacks}">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="model:WorkbenchUIKitStack">
                        <Grid ColumnDefinitions="70,*,*,2*" ColumnSpacing="8">
                          <TextBlock Text="{CompiledBinding Depth}" Classes="mono uikit-value" />
                          <TextBlock Grid.Column="1" Text="{CompiledBinding Name}" Classes="mono" TextTrimming="CharacterEllipsis" ToolTip.Tip="{CompiledBinding Name}" />
                          <TextBlock Grid.Column="2" Text="{CompiledBinding TopPanelName}" Classes="mono" TextTrimming="CharacterEllipsis" ToolTip.Tip="{CompiledBinding TopPanelName}" />
                          <TextBlock Grid.Column="3" Text="{CompiledBinding TopPanelType}" Classes="mono uikit-caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{CompiledBinding TopPanelType}" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Border Classes="kit-empty-state uikit-empty-state" IsVisible="{CompiledBinding IsEmpty}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7" MaxWidth="330">
                      <TextBlock Text="{CompiledBinding EmptyTitleText}" Classes="uikit-section-title" HorizontalAlignment="Center" />
                      <TextBlock Text="{CompiledBinding EmptyHintText}" Classes="uikit-caption" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Border Grid.Row="2" Classes="uikit-truncated-banner" IsVisible="{CompiledBinding StacksTruncated}">
                  <TextBlock Text="{CompiledBinding CoverageText}" Foreground="{DynamicResource Brush.Status.WarningText}" />
                </Border>
              </Grid>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" Classes="uikit-splitter"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                    Background="Transparent"
                    AutomationProperties.Name="{DynamicResource String.UIKit.CollectionDetailsSplitterAutomationName}" />

      <Border x:Name="UIKitDetailPanel" Grid.Column="4" Classes="kit-panel uikit-detail-panel" Padding="0">
        <Grid>
          <Grid IsVisible="{CompiledBinding ShowPanelDetails}" RowDefinitions="Auto,*">
            <Border Classes="kit-panel-header uikit-detail-header">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2">
                  <TextBlock Text="{CompiledBinding SelectedPanel.Name}" Classes="uikit-section-title" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{DynamicResource String.UIKit.PanelDetails}" Classes="uikit-caption" />
                </StackPanel>
                <Button Grid.Column="1" Command="{CompiledBinding CopySelectedCommand}" Classes="secondary icon-button"
                        ToolTip.Tip="{DynamicResource String.Common.Copy}" AutomationProperties.Name="{DynamicResource String.Common.Copy}">
                  <PathIcon Data="{StaticResource Icon.Copy}" Width="14" Height="14" />
                </Button>
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Border Classes="uikit-field-row"><Grid ColumnDefinitions="100,*"><TextBlock Text="{DynamicResource String.Common.Type}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding SelectedPanel.Type}" Classes="mono" TextWrapping="Wrap" /></Grid></Border>
                <Border Classes="uikit-field-row"><Grid ColumnDefinitions="100,*"><TextBlock Text="{DynamicResource String.Common.State}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding SelectedPanel.State, Converter={StaticResource UIKitDisplayText}, ConverterParameter=state}" /></Grid></Border>
                <Border Classes="uikit-field-row"><Grid ColumnDefinitions="100,*"><TextBlock Text="{DynamicResource String.UIKit.Level}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding SelectedPanel.Level, Converter={StaticResource UIKitDisplayText}, ConverterParameter=level}" /></Grid></Border>
                <Border Classes="uikit-field-row"><Grid ColumnDefinitions="100,*"><TextBlock Text="{DynamicResource String.UIKit.LevelOrder}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding SelectedPanel.LevelOrder}" Classes="mono" /></Grid></Border>
                <Border Classes="uikit-field-row"><Grid ColumnDefinitions="100,*"><TextBlock Text="{DynamicResource String.UIKit.SubLevel}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding SelectedPanel.SubLevel}" Classes="mono" /></Grid></Border>
                <Border Classes="uikit-field-row"><Grid ColumnDefinitions="100,*"><TextBlock Text="{DynamicResource String.UIKit.CachePolicy}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding SelectedPanel.CachePolicy, Converter={StaticResource UIKitDisplayText}, ConverterParameter=cache}" /></Grid></Border>
                <Border Classes="uikit-field-row"><Grid ColumnDefinitions="100,*"><TextBlock Text="{DynamicResource String.UIKit.Modal}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding SelectedPanel.IsModal, Converter={StaticResource UIKitDisplayText}, ConverterParameter=boolean}" /></Grid></Border>
                <Border Classes="uikit-field-row"><Grid ColumnDefinitions="100,*"><TextBlock Text="{DynamicResource String.UIKit.NamedStacks}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding SelectedPanel.StackName}" Classes="mono" TextWrapping="Wrap" /></Grid></Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <Grid IsVisible="{CompiledBinding ShowStackDetails}" RowDefinitions="Auto,*">
            <Border Classes="kit-panel-header uikit-detail-header">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2">
                  <TextBlock Text="{CompiledBinding SelectedStack.Name}" Classes="uikit-section-title" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{DynamicResource String.UIKit.StackDetails}" Classes="uikit-caption" />
                </StackPanel>
                <Button Grid.Column="1" Command="{CompiledBinding CopySelectedCommand}" Classes="secondary icon-button"
                        ToolTip.Tip="{DynamicResource String.Common.Copy}" AutomationProperties.Name="{DynamicResource String.Common.Copy}">
                  <PathIcon Data="{StaticResource Icon.Copy}" Width="14" Height="14" />
                </Button>
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Border Classes="uikit-field-row"><Grid ColumnDefinitions="100,*"><TextBlock Text="{DynamicResource String.UIKit.Depth}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding SelectedStack.Depth}" Classes="mono" /></Grid></Border>
                <Border Classes="uikit-field-row"><Grid ColumnDefinitions="100,*"><TextBlock Text="{DynamicResource String.UIKit.TopPanelName}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding SelectedStack.TopPanelName}" Classes="mono" TextWrapping="Wrap" /></Grid></Border>
                <Border Classes="uikit-field-row"><Grid ColumnDefinitions="100,*"><TextBlock Text="{DynamicResource String.UIKit.TopPanelType}" Classes="uikit-label" /><TextBlock Grid.Column="1" Text="{CompiledBinding SelectedStack.TopPanelType}" Classes="mono" TextWrapping="Wrap" /></Grid></Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <Border Classes="kit-empty-state uikit-empty-state" IsVisible="{CompiledBinding ShowNoSelection}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7" MaxWidth="240">
              <TextBlock Text="{DynamicResource String.UIKit.SelectRuntimeItem}" Classes="uikit-section-title" HorizontalAlignment="Center" />
              <TextBlock Text="{DynamicResource String.UIKit.SelectRuntimeItemHint}" Classes="uikit-caption" TextAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      </Grid>

      <Grid x:Name="UIKitCompactLayout" RowDefinitions="Auto,*,220" RowSpacing="9">
      <WrapPanel Orientation="Horizontal">
        <Border Classes="kit-stat uikit-summary-metric"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource String.UIKit.Panels}" Classes="uikit-label" /><TextBlock Text="{CompiledBinding PanelCount}" Classes="mono uikit-summary-value" /></StackPanel></Border>
        <Border Classes="kit-stat uikit-summary-metric"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource String.UIKit.NamedStacks}" Classes="uikit-label" /><TextBlock Text="{CompiledBinding StackCoverageText}" Classes="mono uikit-summary-value" /></StackPanel></Border>
        <Border Classes="kit-stat uikit-summary-metric"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource String.UIKit.Cache.ReusableCached}" Classes="uikit-label" /><TextBlock Text="{CompiledBinding ReusableCachedCount}" Classes="mono uikit-summary-value" /></StackPanel></Border>
        <Border Classes="kit-stat uikit-summary-metric"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource String.UIKit.Modal}" Classes="uikit-label" /><TextBlock Text="{CompiledBinding ModalStatusText}" Classes="mono uikit-summary-value" /></StackPanel></Border>
      </WrapPanel>

      <Border Grid.Row="1" Classes="kit-panel uikit-collection-panel" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <Border Classes="kit-panel-header uikit-collection-header">
            <Grid ColumnDefinitions="*,230" ColumnSpacing="10">
              <TextBlock Text="{DynamicResource String.UIKit.RuntimeCollections}" Classes="uikit-section-title" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{CompiledBinding SearchText, Mode=TwoWay}"
                       PlaceholderText="{DynamicResource String.UIKit.SearchPlaceholder}"
                       AutomationProperties.Name="{DynamicResource String.UIKit.SearchPlaceholder}" />
            </Grid>
          </Border>
          <TabControl Grid.Row="1" SelectedIndex="{CompiledBinding SelectedCollectionIndex, Mode=TwoWay}">
            <TabItem Header="{DynamicResource String.UIKit.Panels}" Classes="kit-tab uikit-tab">
              <Grid>
                <ListBox x:Name="UIKitCompactPanelList" Classes="uikit-list kit-data-list"
                         ItemsSource="{CompiledBinding Panels}"
                         SelectedItem="{CompiledBinding SelectedPanel, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionMode="Single">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="model:WorkbenchUIKitPanel">
                      <Grid ColumnDefinitions="80,*,2*,90" ColumnSpacing="8">
                        <Border Classes="uikit-state-chip" HorizontalAlignment="Left"><TextBlock Text="{CompiledBinding State, Converter={StaticResource UIKitDisplayText}, ConverterParameter=state}" Classes="uikit-chip-text" /></Border>
                        <TextBlock Grid.Column="1" Text="{CompiledBinding Name}" Classes="mono" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{CompiledBinding Type}" Classes="mono uikit-caption" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{CompiledBinding Level, Converter={StaticResource UIKitDisplayText}, ConverterParameter=level}" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Border Classes="kit-empty-state uikit-empty-state" IsVisible="{CompiledBinding IsEmpty}">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                    <TextBlock Text="{CompiledBinding EmptyTitleText}" Classes="uikit-section-title" HorizontalAlignment="Center" />
                    <TextBlock Text="{CompiledBinding EmptyHintText}" Classes="uikit-caption" TextAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource String.UIKit.NamedStacks}" Classes="kit-tab uikit-tab">
              <Grid>
                <ListBox x:Name="UIKitCompactStackList" Classes="uikit-list kit-data-list"
                         ItemsSource="{CompiledBinding Stacks}"
                         SelectedItem="{CompiledBinding SelectedStack, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionMode="Single">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="model:WorkbenchUIKitStack">
                      <Grid ColumnDefinitions="70,*,*,2*" ColumnSpacing="8">
                        <TextBlock Text="{CompiledBinding Depth}" Classes="mono uikit-value" />
                        <TextBlock Grid.Column="1" Text="{CompiledBinding Name}" Classes="mono" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{CompiledBinding TopPanelName}" Classes="mono" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{CompiledBinding TopPanelType}" Classes="mono uikit-caption" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Border Classes="kit-empty-state uikit-empty-state" IsVisible="{CompiledBinding IsEmpty}">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                    <TextBlock Text="{CompiledBinding EmptyTitleText}" Classes="uikit-section-title" HorizontalAlignment="Center" />
                    <TextBlock Text="{CompiledBinding EmptyHintText}" Classes="uikit-caption" TextAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>

      <Border Grid.Row="2" Classes="kit-panel uikit-detail-panel" Padding="0">
        <Grid>
          <Grid IsVisible="{CompiledBinding ShowPanelDetails}" RowDefinitions="Auto,*">
            <Border Classes="kit-panel-header uikit-detail-header">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{CompiledBinding SelectedPanel.Name}" Classes="uikit-section-title" VerticalAlignment="Center" />
                <Button Grid.Column="1" Command="{CompiledBinding CopySelectedCommand}" Classes="secondary icon-button"
                        ToolTip.Tip="{DynamicResource String.Common.Copy}" AutomationProperties.Name="{DynamicResource String.Common.Copy}">
                  <PathIcon Data="{StaticResource Icon.Copy}" Width="14" Height="14" />
                </Button>
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <WrapPanel Margin="10" Orientation="Horizontal">
                <Border Classes="kit-stat uikit-summary-metric"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource String.Common.Type}" Classes="uikit-label" /><TextBlock Text="{CompiledBinding SelectedPanel.Type}" Classes="mono" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
                <Border Classes="kit-stat uikit-summary-metric"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource String.Common.State}" Classes="uikit-label" /><TextBlock Text="{CompiledBinding SelectedPanel.State, Converter={StaticResource UIKitDisplayText}, ConverterParameter=state}" /><TextBlock Text="{CompiledBinding SelectedPanel.Level, Converter={StaticResource UIKitDisplayText}, ConverterParameter=level}" Classes="uikit-caption" /></StackPanel></Border>
                <Border Classes="kit-stat uikit-summary-metric"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource String.UIKit.CachePolicy}" Classes="uikit-label" /><TextBlock Text="{CompiledBinding SelectedPanel.CachePolicy, Converter={StaticResource UIKitDisplayText}, ConverterParameter=cache}" /></StackPanel></Border>
                <Border Classes="kit-stat uikit-summary-metric"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource String.UIKit.NamedStacks}" Classes="uikit-label" /><TextBlock Text="{CompiledBinding SelectedPanel.StackName}" Classes="mono" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
              </WrapPanel>
            </ScrollViewer>
          </Grid>
          <Grid IsVisible="{CompiledBinding ShowStackDetails}" RowDefinitions="Auto,*">
            <Border Classes="kit-panel-header uikit-detail-header">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{CompiledBinding SelectedStack.Name}" Classes="uikit-section-title" VerticalAlignment="Center" />
                <Button Grid.Column="1" Command="{CompiledBinding CopySelectedCommand}" Classes="secondary icon-button"
                        ToolTip.Tip="{DynamicResource String.Common.Copy}" AutomationProperties.Name="{DynamicResource String.Common.Copy}">
                  <PathIcon Data="{StaticResource Icon.Copy}" Width="14" Height="14" />
                </Button>
              </Grid>
            </Border>
            <WrapPanel Grid.Row="1" Margin="10" Orientation="Horizontal">
              <Border Classes="kit-stat uikit-summary-metric"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource String.UIKit.Depth}" Classes="uikit-label" /><TextBlock Text="{CompiledBinding SelectedStack.Depth}" Classes="mono uikit-summary-value" /></StackPanel></Border>
              <Border Classes="kit-stat uikit-summary-metric"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource String.UIKit.TopPanelName}" Classes="uikit-label" /><TextBlock Text="{CompiledBinding SelectedStack.TopPanelName}" Classes="mono" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
              <Border Classes="kit-stat uikit-summary-metric"><StackPanel Spacing="2"><TextBlock Text="{DynamicResource String.UIKit.TopPanelType}" Classes="uikit-label" /><TextBlock Text="{CompiledBinding SelectedStack.TopPanelType}" Classes="mono" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
            </WrapPanel>
          </Grid>
          <Border Classes="kit-empty-state uikit-empty-state" IsVisible="{CompiledBinding ShowNoSelection}">
            <TextBlock Text="{DynamicResource String.Common.SelectAnItem}" Classes="uikit-section-title" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Grid>
      </Border>
      </Grid>
    </Grid>

    <pages:UIKitEditorToolsView Grid.Row="1" Grid.RowSpan="2"
                                IsVisible="{CompiledBinding IsEditorToolsTask}" />
  </Grid>
</UserControl>
