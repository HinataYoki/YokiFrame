<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:eventKit="using:YokiFrame.Tooling.Application.Models.EventKit"
             xmlns:eventVm="using:YokiFrame.Workbench.Avalonia.ViewModels.EventKit"
             xmlns:vm="using:YokiFrame.Workbench.Avalonia.ViewModels"
             x:Class="YokiFrame.Workbench.Avalonia.Views.Pages.EventKitPageView"
             x:DataType="vm:EventKitPageViewModel"
             AutomationProperties.AutomationId="workbench.eventkit.page">
  <UserControl.Resources>
    <DataTemplate x:Key="EventKitCodeGroupTemplate"
                  x:DataType="eventVm:EventKitCodeLocationGroupViewModel">
      <Border Classes="eventkit-code-group"
              ToolTip.Tip="{CompiledBinding FilePath}">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
          <TextBlock Text="{CompiledBinding FileName}"
                     FontSize="{DynamicResource FontSize.Body}"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
          <ItemsControl Grid.Row="1" ItemsSource="{CompiledBinding Locations}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="eventVm:EventKitCodeLocationItemViewModel">
                <Button Classes="eventkit-code-line"
                        Content="{CompiledBinding Line, StringFormat='L{0}'}"
                        Command="{CompiledBinding OpenCommand}"
                        ToolTip.Tip="{CompiledBinding FilePath}"
                        AutomationProperties.Name="{CompiledBinding OpenAutomationName}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Classes="eventkit-layout">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="10*" MinWidth="560" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="3*" MinWidth="330" />
    </Grid.ColumnDefinitions>

    <Grid RowDefinitions="Auto,*">
      <Border Margin="12"
              Padding="24"
              Grid.RowSpan="2"
              IsVisible="{CompiledBinding IsEmpty}"
              Classes="kit-empty-state eventkit-empty-state">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
          <TextBlock Text="尚无 EventKit 关系" Classes="h2" TextAlignment="Center" />
          <TextBlock Text="{CompiledBinding EmptyDescription}"
                     Classes="body"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
          <TextBlock Text="重新进入页面会自动扫描；Play Mode 活动会实时补充。"
                     Classes="muted"
                     FontSize="{DynamicResource FontSize.Sm}"
                     TextAlignment="Center" />
        </StackPanel>
      </Border>

      <Grid IsVisible="{CompiledBinding HasEvents}"
            Classes="eventkit-column-header"
            ColumnDefinitions="3*,14,4*,14,3*">
        <TextBlock Text="发送方代码"
                   Classes="eventkit-column-title" />
        <TextBlock Grid.Column="2"
                   Text="事件通道"
                   Classes="eventkit-column-title center" />
        <TextBlock Grid.Column="4"
                   Text="注册 / 注销方"
                   Classes="eventkit-column-title" />
      </Grid>

      <ListBox Grid.Row="1"
               IsVisible="{CompiledBinding HasEvents}"
               Classes="eventkit-relation-list kit-selection-list rich"
               ItemsSource="{CompiledBinding Events}"
               SelectedItem="{CompiledBinding SelectedEvent, Mode=TwoWay}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               AutomationProperties.Name="EventKit 发送注册关系"
               AutomationProperties.AutomationId="workbench.eventkit.relations">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="eventVm:EventKitEventListItemViewModel">
            <!-- 一行就是一条完整通道：发送端、事件核心和接收端始终保持同屏。 -->
            <Grid MinHeight="88" ColumnDefinitions="3*,14,4*,14,3*">
              <Border Classes="eventkit-endpoint sender"
                      ToolTip.Tip="{CompiledBinding SenderPreview.FilePath}">
                <Grid RowDefinitions="Auto,Auto"
                      RowSpacing="5"
                      VerticalAlignment="Center">
                  <TextBlock Text="{CompiledBinding SenderPreview.FileName}"
                             Classes="mono eventkit-code-file"
                             TextTrimming="CharacterEllipsis"
                             TextAlignment="Right"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             IsVisible="{CompiledBinding HasSenders}" />
                  <TextBlock
                             Text="未扫描到发送方"
                             Classes="eventkit-relation-empty"
                             TextAlignment="Right"
                             HorizontalAlignment="Stretch"
                             IsVisible="{CompiledBinding HasNoSenders}" />
                  <StackPanel Grid.Row="1"
                              Orientation="Horizontal"
                              Spacing="4"
                              HorizontalAlignment="Right"
                              IsVisible="{CompiledBinding HasSenders}">
                    <TextBlock Text="{CompiledBinding SenderCountText}"
                               Classes="mono eventkit-position-count"
                               VerticalAlignment="Center" />
                    <Button Classes="eventkit-code-line preview"
                            Content="{CompiledBinding SenderPreview.Line, StringFormat='L{0}'}"
                            Command="{CompiledBinding SenderPreview.OpenCommand}"
                            ToolTip.Tip="{CompiledBinding SenderPreview.FilePath}"
                            AutomationProperties.Name="{CompiledBinding SenderPreview.OpenAutomationName}" />
                  </StackPanel>
                </Grid>
              </Border>

              <TextBlock Grid.Column="1"
                         Text="›"
                         Classes="eventkit-flow-connector"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center" />

              <Border Grid.Column="2"
                      Classes="eventkit-event-hub"
                      Classes.type="{CompiledBinding IsType}"
                      Classes.enum="{CompiledBinding IsEnum}"
                      Classes.string="{CompiledBinding IsString}"
                      ToolTip.Tip="{CompiledBinding FlowCoverageText}">
                <Grid RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="2"
                      VerticalAlignment="Center">
                  <Border Classes="eventkit-channel type"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          IsVisible="{CompiledBinding IsType}">
                    <TextBlock Text="Type" FontSize="{DynamicResource FontSize.Sm}" />
                  </Border>
                  <Border Classes="eventkit-channel enum"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          IsVisible="{CompiledBinding IsEnum}">
                    <TextBlock Text="Enum" FontSize="{DynamicResource FontSize.Sm}" />
                  </Border>
                  <Border Classes="eventkit-channel string"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          IsVisible="{CompiledBinding IsString}">
                    <TextBlock Text="String" FontSize="{DynamicResource FontSize.Sm}" />
                  </Border>
                  <TextBlock Margin="48,0"
                             Text="{CompiledBinding EventKeyDisplay}"
                             FontSize="{DynamicResource FontSize.Lg}"
                             FontWeight="SemiBold"
                             TextAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{CompiledBinding EventKey}" />
                  <TextBlock Grid.Row="1"
                             Text="{CompiledBinding PayloadSummaryText}"
                             FontSize="{DynamicResource FontSize.Body}"
                             TextAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{CompiledBinding PayloadType}" />
                  <TextBlock Grid.Row="2"
                             Text="{CompiledBinding RelationCountText}"
                             Classes="mono eventkit-relation-count"
                             TextAlignment="Center"
                             ToolTip.Tip="{CompiledBinding LifetimeBalanceText}"
                             VerticalAlignment="Center" />
                </Grid>
              </Border>

              <TextBlock Grid.Column="3"
                         Text="›"
                         Classes="eventkit-flow-connector"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center" />

              <Border Grid.Column="4"
                      Classes="eventkit-endpoint receiver">
                <Grid RowDefinitions="Auto,Auto"
                      RowSpacing="4"
                      VerticalAlignment="Center">
                  <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="4">
                    <TextBlock Text="注册"
                               Classes="eventkit-lifecycle-label register" />
                    <TextBlock Grid.Column="1"
                               Text="{CompiledBinding ReceiverPreview.FileName}"
                               Classes="mono eventkit-code-file"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{CompiledBinding ReceiverPreview.FilePath}"
                               VerticalAlignment="Center"
                               IsVisible="{CompiledBinding HasReceivers}" />
                    <TextBlock Grid.Column="1"
                               Text="未扫描到注册方"
                               Classes="eventkit-relation-empty"
                               IsVisible="{CompiledBinding HasNoReceivers}" />
                    <Button Grid.Column="2"
                            Classes="eventkit-code-line preview register"
                            Content="{CompiledBinding ReceiverPreview.Line, StringFormat='+ L{0}'}"
                            Command="{CompiledBinding ReceiverPreview.OpenCommand}"
                            ToolTip.Tip="{CompiledBinding ReceiverPreview.FilePath}"
                            AutomationProperties.Name="{CompiledBinding ReceiverPreview.OpenAutomationName}"
                            IsVisible="{CompiledBinding HasReceivers}" />
                  </Grid>
                  <Grid Grid.Row="1"
                        ColumnDefinitions="40,*,Auto"
                        ColumnSpacing="4">
                    <TextBlock Text="注销"
                               Classes="eventkit-lifecycle-label unregister" />
                    <TextBlock Grid.Column="1"
                               Text="{CompiledBinding UnregisterPreview.FileName}"
                               Classes="mono eventkit-code-file"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{CompiledBinding UnregisterPreview.FilePath}"
                               VerticalAlignment="Center"
                               IsVisible="{CompiledBinding HasUnregisters}" />
                    <TextBlock Grid.Column="1"
                               Text="未扫描到注销方"
                               Classes="eventkit-relation-empty eventkit-unregister-empty"
                               Classes.warning="{CompiledBinding HasMissingUnregister}"
                               IsVisible="{CompiledBinding HasNoUnregisters}" />
                    <Button Grid.Column="2"
                            Classes="eventkit-code-line preview unregister"
                            Content="{CompiledBinding UnregisterPreview.Line, StringFormat='- L{0}'}"
                            Command="{CompiledBinding UnregisterPreview.OpenCommand}"
                            ToolTip.Tip="{CompiledBinding UnregisterPreview.FilePath}"
                            AutomationProperties.Name="{CompiledBinding UnregisterPreview.OpenAutomationName}"
                            IsVisible="{CompiledBinding HasUnregisters}" />
                  </Grid>
                </Grid>
              </Border>

              <Border Grid.ColumnSpan="5"
                      Width="3"
                      HorizontalAlignment="Left"
                      Classes="eventkit-selection-rail"
                      IsHitTestVisible="False"
                      ZIndex="2" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <GridSplitter Grid.Column="1"
                  Width="4"
                  HorizontalAlignment="Center"
                  Background="{DynamicResource Brush.Border.Subtle}"
                  ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndNext" />

    <Border Grid.Column="2" Classes="panel eventkit-detail-panel" Padding="0">
      <Grid>
        <Border Margin="12"
                Padding="20"
                IsVisible="{CompiledBinding IsSelectionEmpty}"
                Classes="kit-empty-state eventkit-empty-state">
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="6">
            <TextBlock Text="选择一个事件关系" FontWeight="SemiBold" />
            <TextBlock Text="右侧显示所选事件与运行时间线。"
                       Classes="muted"
                       FontSize="{DynamicResource FontSize.Sm}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Grid IsVisible="{CompiledBinding HasSelection}"
              RowDefinitions="Auto,*">
          <Border Margin="12,12,12,8"
                  Padding="12,10"
                  Classes="eventkit-detail-header"
                  Classes.type="{CompiledBinding SelectedIsType}"
                  Classes.enum="{CompiledBinding SelectedIsEnum}"
                  Classes.string="{CompiledBinding SelectedIsString}">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Border Classes="eventkit-channel type"
                        IsVisible="{CompiledBinding SelectedIsType}">
                  <TextBlock Text="Type" FontSize="{DynamicResource FontSize.Sm}" />
                </Border>
                <Border Classes="eventkit-channel enum"
                        IsVisible="{CompiledBinding SelectedIsEnum}">
                  <TextBlock Text="Enum" FontSize="{DynamicResource FontSize.Sm}" />
                </Border>
                <Border Classes="eventkit-channel string"
                        IsVisible="{CompiledBinding SelectedIsString}">
                  <TextBlock Text="String" FontSize="{DynamicResource FontSize.Sm}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{CompiledBinding SelectedEventKey}"
                           FontSize="{DynamicResource FontSize.Lg}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{CompiledBinding SelectedEventKey}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Classes="eventkit-code-summary"
                        Content="{CompiledBinding SelectedEvent.RelationCountText}"
                        ToolTip.Tip="查看全部代码位置">
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                      <Border Width="360"
                              MaxHeight="420"
                              Padding="12"
                              Classes="eventkit-code-flyout">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                          <StackPanel Spacing="10">
                            <TextBlock Text="代码位置" Classes="section-title" />
                            <StackPanel Spacing="4">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="发送位置" Classes="eventkit-relation-group-title" />
                                <TextBlock Grid.Column="1"
                                           Text="{CompiledBinding SelectedEvent.SenderCountText}"
                                           Classes="mono eventkit-relation-group-title" />
                              </Grid>
                              <ItemsControl ItemsSource="{CompiledBinding SelectedEvent.SenderGroups}"
                                            ItemTemplate="{StaticResource EventKitCodeGroupTemplate}" />
                              <TextBlock Text="未扫描到发送方"
                                         Classes="eventkit-relation-empty"
                                         IsVisible="{CompiledBinding SelectedEvent.HasNoSenders}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="注册位置" Classes="eventkit-relation-group-title" />
                                <TextBlock Grid.Column="1"
                                           Text="{CompiledBinding SelectedEvent.ReceiverCountText}"
                                           Classes="mono eventkit-relation-group-title" />
                              </Grid>
                              <ItemsControl ItemsSource="{CompiledBinding SelectedEvent.ReceiverGroups}"
                                            ItemTemplate="{StaticResource EventKitCodeGroupTemplate}" />
                              <TextBlock Text="未扫描到注册方"
                                         Classes="eventkit-relation-empty"
                                         IsVisible="{CompiledBinding SelectedEvent.HasNoReceivers}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="注销位置" Classes="eventkit-relation-group-title" />
                                <TextBlock Grid.Column="1"
                                           Text="{CompiledBinding SelectedEvent.UnregisterCountText}"
                                           Classes="mono eventkit-relation-group-title" />
                              </Grid>
                              <ItemsControl ItemsSource="{CompiledBinding SelectedEvent.UnregisterGroups}"
                                            ItemTemplate="{StaticResource EventKitCodeGroupTemplate}" />
                              <TextBlock Text="未扫描到注销方"
                                         Classes="eventkit-relation-empty"
                                         IsVisible="{CompiledBinding SelectedEvent.HasNoUnregisters}" />
                            </StackPanel>
                          </StackPanel>
                        </ScrollViewer>
                      </Border>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </Grid>
              <TextBlock Grid.Row="1"
                         Text="{CompiledBinding SelectedPayloadSummaryText}"
                         FontSize="{DynamicResource FontSize.Body}"
                         TextWrapping="Wrap"
                         MaxLines="2"
                         ToolTip.Tip="{CompiledBinding SelectedPayloadText}" />
              <WrapPanel Grid.Row="2">
                <Border Classes="eventkit-health">
                  <TextBlock Text="{CompiledBinding SelectedEvent.FlowCoverageText}" />
                </Border>
                <Border Classes="eventkit-health">
                  <TextBlock Text="{CompiledBinding SelectedEvent.LifetimeBalanceText}" />
                </Border>
              </WrapPanel>
            </Grid>
          </Border>

          <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Grid Margin="12,0,12,7" ColumnDefinitions="*,Auto">
              <TextBlock Text="运行时间线" Classes="section-title" />
              <TextBlock Grid.Column="1"
                         Text="{CompiledBinding SelectedActivityCountText}"
                         Classes="muted"
                         FontSize="{DynamicResource FontSize.Sm}"
                         VerticalAlignment="Center" />
            </Grid>
            <ListBox Grid.Row="1"
                     Classes="eventkit-timeline kit-timeline-list"
                     ItemsSource="{CompiledBinding SelectedActivities}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="EventKit 运行时间线">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="eventKit:WorkbenchEventKitActivity">
                  <Grid ColumnDefinitions="82,64,*" ColumnSpacing="7">
                    <TextBlock Text="{CompiledBinding Time}"
                               Classes="muted mono"
                               FontSize="{DynamicResource FontSize.Sm}" />
                    <TextBlock Grid.Column="1"
                               Text="{CompiledBinding Kind}"
                               Classes="eventkit-timeline-kind"
                               FontSize="{DynamicResource FontSize.Sm}"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2"
                               Text="{CompiledBinding Detail}"
                               Classes="mono"
                               FontSize="{DynamicResource FontSize.Body}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{CompiledBinding Detail}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
