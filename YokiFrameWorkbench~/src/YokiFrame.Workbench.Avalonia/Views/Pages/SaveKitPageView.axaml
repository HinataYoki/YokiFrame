<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokiFrame.Workbench.Avalonia.ViewModels"
             xmlns:model="using:YokiFrame.Tooling.Application.Models.SaveKit"
             x:Class="YokiFrame.Workbench.Avalonia.Views.Pages.SaveKitPageView"
             x:DataType="vm:SaveKitPageViewModel"
             Padding="0">
  <UserControl.Styles>
    <Style Selector="ToggleButton.savekit-filter">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1,1,0,1" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ToggleButton.savekit-filter.last">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0,4,4,0" />
    </Style>
    <Style Selector="ToggleButton.savekit-filter:checked">
      <Setter Property="Background" Value="{DynamicResource Brush.Action.Selected}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Action.Primary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" RowSpacing="10">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="6">
      <Border Classes="kit-stat savekit-stat">
        <StackPanel Spacing="1">
          <TextBlock Text="{DynamicResource String.SaveKit.SlotFiles}" Classes="muted" FontSize="{DynamicResource FontSize.Xs}" />
          <TextBlock Text="{CompiledBinding SlotCount}" FontSize="{DynamicResource FontSize.Lg}" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="kit-stat savekit-stat">
        <StackPanel Spacing="1">
          <TextBlock Text="{DynamicResource String.SaveKit.GlobalFiles}" Classes="muted" FontSize="{DynamicResource FontSize.Xs}" />
          <TextBlock Text="{CompiledBinding GlobalCount}" FontSize="{DynamicResource FontSize.Lg}" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="kit-stat savekit-stat">
        <StackPanel Spacing="1">
          <TextBlock Text="{DynamicResource String.SaveKit.TotalFiles}" Classes="muted" FontSize="{DynamicResource FontSize.Xs}" />
          <TextBlock Text="{CompiledBinding FileCount}" FontSize="{DynamicResource FontSize.Lg}" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
      <Border Grid.Column="3"
              Classes="kit-stat savekit-config-summary"
              HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <TextBlock Text="{DynamicResource String.SaveKit.ConfigFile}" Classes="muted" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{CompiledBinding ConfigPath}"
                     Classes="mono savekit-path"
                     ToolTip.Tip="{CompiledBinding ConfigPath}"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="350" MinWidth="300" MaxWidth="440" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" MinWidth="360" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Classes="kit-panel" Padding="14" ClipToBounds="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <StackPanel Spacing="3">
                <TextBlock Text="{DynamicResource String.SaveKit.SaveConfig}" Classes="section-title" />
                <TextBlock Text="{DynamicResource String.SaveKit.SaveConfigHint}"
                           Classes="muted"
                           FontSize="{DynamicResource FontSize.Xs}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1"
                      Command="{CompiledBinding RefreshCommand}"
                      Classes="secondary icon"
                      ToolTip.Tip="{DynamicResource String.Common.Refresh}"
                      AutomationProperties.Name="{DynamicResource String.Common.Refresh}">
                <PathIcon Data="{StaticResource Icon.RotateCcw}" Width="14" Height="14" />
              </Button>
            </Grid>

            <StackPanel Spacing="5">
              <TextBlock Text="{DynamicResource String.SaveKit.SaveDirectory}" Classes="muted" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Text="{CompiledBinding StoragePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="${persistentDataPath}/YokiFrame/Saves"
                         AutomationProperties.Name="{DynamicResource String.SaveKit.SaveDirectory}" />
                <Button Grid.Column="1"
                        Command="{CompiledBinding BrowseFolderCommand}"
                        Classes="secondary icon"
                        ToolTip.Tip="{DynamicResource String.SaveKit.SaveDirectory}"
                        AutomationProperties.Name="{DynamicResource String.SaveKit.SaveDirectory}">
                  <PathIcon Data="{StaticResource Icon.Folder}" Width="15" Height="15" />
                </Button>
              </Grid>
            </StackPanel>

            <StackPanel Spacing="5">
              <TextBlock Text="{DynamicResource String.SaveKit.FileExtension}" Classes="muted" />
              <TextBox Text="{CompiledBinding FileExtension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText=".yoki"
                       AutomationProperties.Name="{DynamicResource String.SaveKit.FileExtension}" />
            </StackPanel>

            <Border Classes="savekit-resolved-path">
              <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{DynamicResource String.SaveKit.ActualScanPath}"
                             Classes="muted"
                             FontSize="{DynamicResource FontSize.Xs}"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="1"
                          Command="{CompiledBinding OpenDirectoryCommand}"
                          Classes="secondary icon"
                          ToolTip.Tip="{DynamicResource String.Common.OpenDirectory}"
                           AutomationProperties.Name="{DynamicResource String.SaveKit.OpenDirectoryAutomationName}">
                    <PathIcon Data="{StaticResource Icon.Folder}" Width="14" Height="14" />
                  </Button>
                </Grid>
                <TextBlock Grid.Row="1"
                           Text="{CompiledBinding ResolvedStoragePath}"
                           Classes="mono savekit-path"
                           FontSize="{DynamicResource FontSize.Xs}"
                           ToolTip.Tip="{CompiledBinding ResolvedStoragePath}"
                           TextWrapping="Wrap" />
              </Grid>
            </Border>

            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource String.SaveKit.RuntimeStatus}" Classes="section-title" />
                <TextBlock Grid.Column="1"
                           Text="{CompiledBinding RuntimeStatusText}"
                           Classes="muted"
                           FontSize="{DynamicResource FontSize.Xs}"
                           VerticalAlignment="Center" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                <TextBlock Text="Storage" Classes="muted" FontSize="{DynamicResource FontSize.Xs}" />
                <TextBlock Grid.Column="1"
                           Text="{CompiledBinding RuntimeStorageText}"
                           Classes="mono"
                           FontSize="{DynamicResource FontSize.Xs}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{CompiledBinding RuntimeStorageText}" />
                <TextBlock Grid.Row="1" Text="Serializer" Classes="muted" FontSize="{DynamicResource FontSize.Xs}" />
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{CompiledBinding RuntimeSerializerText}"
                           Classes="mono"
                           FontSize="{DynamicResource FontSize.Xs}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{CompiledBinding RuntimeSerializerText}" />
                <TextBlock Grid.Row="2" Text="{DynamicResource String.SaveKit.Encryption}" Classes="muted" FontSize="{DynamicResource FontSize.Xs}" />
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{CompiledBinding RuntimeEncryptorText}"
                           Classes="mono"
                           FontSize="{DynamicResource FontSize.Xs}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{CompiledBinding RuntimeEncryptorText}" />
                <TextBlock Grid.Row="3" Text="{DynamicResource String.SaveKit.AutoSave}" Classes="muted" FontSize="{DynamicResource FontSize.Xs}" />
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Text="{CompiledBinding RuntimeAutoSaveText}"
                           Classes="mono"
                           FontSize="{DynamicResource FontSize.Xs}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{CompiledBinding RuntimeAutoSaveText}" />
                <TextBlock Grid.Row="4" Text="{DynamicResource String.SaveKit.HeaderMetadata}" Classes="muted" FontSize="{DynamicResource FontSize.Xs}" />
                <TextBlock Grid.Row="4" Grid.Column="1"
                           Text="{CompiledBinding RuntimeMetadataText}"
                           Classes="mono"
                           FontSize="{DynamicResource FontSize.Xs}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{CompiledBinding RuntimeMetadataText}" />
              </Grid>
              <TextBlock Text="{CompiledBinding RuntimeWarningText}"
                         Foreground="{DynamicResource Brush.Terminal.Error}"
                         FontSize="{DynamicResource FontSize.Xs}"
                         TextWrapping="Wrap"
                         IsVisible="{CompiledBinding HasRuntimeWarning}"
                         AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <Border IsVisible="{CompiledBinding !IsSupported}" Classes="card">
              <TextBlock Text="{DynamicResource String.SaveKit.EngineNotSupported}"
                         Classes="muted"
                         TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{CompiledBinding ErrorText}"
                       Foreground="{DynamicResource Brush.Terminal.Error}"
                       TextWrapping="Wrap"
                       IsVisible="{CompiledBinding HasError}"
                       AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Command="{CompiledBinding ResetCommand}"
                      Classes="secondary compact-action"
                      Content="{DynamicResource String.SaveKit.RestoreDefault}" />
              <Button Command="{CompiledBinding SaveCommand}"
                      Classes="primary compact-action"
                      Content="{DynamicResource String.Common.Save}" />
            </StackPanel>
            <TextBlock Text="{CompiledBinding StatusText}"
                       Classes="muted"
                       FontSize="{DynamicResource FontSize.Xs}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <GridSplitter Grid.Column="1"
                    Classes="savekit-master-splitter"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    Cursor="SizeWestEast"
                    AutomationProperties.Name="{DynamicResource String.SaveKit.PageSplitterAutomationName}" />

      <Border Grid.Column="2" Classes="kit-panel" Padding="0" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Classes="savekit-files-header">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="9">
              <StackPanel Spacing="2">
                <TextBlock Text="{DynamicResource String.SaveKit.SaveFiles}" Classes="section-title" />
                <TextBlock Text="{DynamicResource String.SaveKit.SaveFilesHint}"
                           Classes="muted"
                           FontSize="{DynamicResource FontSize.Xs}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Width="220"
                         MaxWidth="220"
                         HorizontalAlignment="Left"
                         Text="{CompiledBinding SearchText, Mode=TwoWay}"
                         PlaceholderText="{DynamicResource String.SaveKit.SearchPlaceholder}"
                         AutomationProperties.Name="{DynamicResource String.SaveKit.SearchFilesAutomationName}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <ToggleButton Classes="savekit-filter"
                                Command="{CompiledBinding SelectAllCommand}"
                                Content="{DynamicResource String.LocalizationKit.AllLanguages}"
                                IsChecked="{CompiledBinding IsAllFilter, Mode=OneWay}" />
                  <ToggleButton Classes="savekit-filter"
                                Command="{CompiledBinding SelectSlotCommand}"
                                IsChecked="{CompiledBinding IsSlotFilter, Mode=OneWay}">Slot</ToggleButton>
                  <ToggleButton Classes="savekit-filter last"
                                Command="{CompiledBinding SelectGlobalCommand}"
                                IsChecked="{CompiledBinding IsGlobalFilter, Mode=OneWay}">Global</ToggleButton>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <Grid Grid.Row="1">
            <ListBox Classes="savekit-files kit-data-list"
                     ItemsSource="{CompiledBinding FilteredFiles}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="model:WorkbenchSaveKitFile">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                    <Border Classes="badge">
                      <TextBlock Text="{CompiledBinding Kind}" FontSize="{DynamicResource FontSize.Xs}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{CompiledBinding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{CompiledBinding FullPath}"
                                 Classes="mono muted"
                                 FontSize="{DynamicResource FontSize.Xs}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{CompiledBinding FullPath}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{CompiledBinding SizeText}"
                               Classes="mono muted"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{CompiledBinding ModifiedText}"
                               Classes="mono muted"
                               FontSize="{DynamicResource FontSize.Xs}"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel IsVisible="{CompiledBinding IsEmpty}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="7"
                        MaxWidth="320"
                        Margin="24"
                        IsHitTestVisible="False">
              <PathIcon Data="{StaticResource Icon.Folder}"
                        Width="26"
                        Height="26"
                        Foreground="{DynamicResource Brush.Text.Muted}"
                        HorizontalAlignment="Center" />
              <TextBlock Text="{DynamicResource String.SaveKit.NoMatchingFiles}"
                         Classes="muted"
                         HorizontalAlignment="Center"
                         TextAlignment="Center" />
              <TextBlock Text="{DynamicResource String.SaveKit.NoMatchingFilesHint}"
                         Classes="muted"
                         FontSize="{DynamicResource FontSize.Xs}"
                         HorizontalAlignment="Center"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
