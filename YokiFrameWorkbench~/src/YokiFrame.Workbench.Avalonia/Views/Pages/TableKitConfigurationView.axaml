<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokiFrame.Workbench.Avalonia.ViewModels"
             x:Class="YokiFrame.Workbench.Avalonia.Views.Pages.TableKitConfigurationView"
             x:DataType="vm:TableKitPageViewModel">
  <Grid x:Name="TableKitConfigLayout"
        ColumnDefinitions="*,20,*"
        Margin="16,14,16,18"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
    <Border x:Name="TableKitLeftPane"
            Grid.Column="0"
            Classes="tablekit-config-pane">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Border Classes="tablekit-config-section">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="3,*,Auto" ColumnSpacing="9">
              <Border Classes="tablekit-section-accent" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{DynamicResource String.TableKit.LubanPaths}" Classes="section-title" />
                <TextBlock Text="{DynamicResource String.TableKit.LubanPathsHint}" Classes="tablekit-hint" />
              </StackPanel>
              <TextBlock Grid.Column="2"
                         Text="{CompiledBinding LubanStatusText}"
                         Classes="mono tablekit-kicker"
                         VerticalAlignment="Center" />
            </Grid>
            <Grid ColumnDefinitions="92,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
              <TextBlock Text="{DynamicResource String.TableKit.LubanWorkDir}" Classes="muted" VerticalAlignment="Center" />
              <TextBox x:Name="TableKitLubanWorkDir"
                       Grid.Column="1"
                       Text="{CompiledBinding LubanWorkDir, Mode=TwoWay}"
                       IsReadOnly="True"
                       ToolTip.Tip="{CompiledBinding LubanWorkDir}"
                       AutomationProperties.Name="{DynamicResource String.TableKit.LubanWorkDirAutomationName}" />
              <Button Grid.Column="2"
                      Command="{CompiledBinding BrowseLubanWorkDirCommand}"
                      Classes="secondary compact-action"
                      AutomationProperties.Name="{DynamicResource String.TableKit.BrowseLubanWorkDir}">
                <PathIcon Data="{StaticResource Icon.Folder}" Width="13" Height="13" />
              </Button>
              <TextBlock Grid.Row="1" Text="Luban.dll" Classes="muted" VerticalAlignment="Center" />
              <TextBox x:Name="TableKitLubanExecutablePath"
                       Grid.Row="1"
                       Grid.Column="1"
                       Text="{CompiledBinding LubanExecutablePath, Mode=TwoWay}"
                       IsReadOnly="True"
                       ToolTip.Tip="{CompiledBinding LubanExecutablePath}"
                       AutomationProperties.Name="{DynamicResource String.TableKit.LubanExecutableAutomationName}" />
              <Button Grid.Row="1"
                      Grid.Column="2"
                      Command="{CompiledBinding BrowseLubanExecutableCommand}"
                      Classes="secondary compact-action"
                       ToolTip.Tip="{DynamicResource String.TableKit.SelectLubanDll}"
                       AutomationProperties.Name="{DynamicResource String.TableKit.SelectLubanDll}">
                <PathIcon Data="{StaticResource Icon.Folder}" Width="13" Height="13" />
              </Button>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="tablekit-config-section">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="3,*" ColumnSpacing="9">
              <Border Classes="tablekit-section-accent" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{DynamicResource String.TableKit.TargetConfig}" Classes="section-title" />
                <TextBlock Text="{DynamicResource String.TableKit.TargetConfigHint}" Classes="tablekit-hint" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
              <StackPanel Spacing="4">
                <TextBlock Text="Target" Classes="tablekit-label" />
                <ComboBox ItemsSource="{CompiledBinding TargetOptions}"
                          SelectedItem="{CompiledBinding TargetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Code target" Classes="tablekit-label" />
                <ComboBox ItemsSource="{CompiledBinding CodeTargetOptions}"
                          SelectedItem="{CompiledBinding CodeTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Data target" Classes="tablekit-label" />
                <ComboBox ItemsSource="{CompiledBinding DataTargetOptions}"
                          SelectedItem="{CompiledBinding DataTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="92,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
              <TextBlock Text="{DynamicResource String.TableKit.OutputDataDir}" Classes="muted" VerticalAlignment="Center" />
              <TextBox x:Name="TableKitOutputDataDir"
                       Grid.Column="1"
                       Text="{CompiledBinding OutputDataDir, Mode=TwoWay}"
                       IsReadOnly="True"
                       ToolTip.Tip="{CompiledBinding OutputDataDir}"
                       AutomationProperties.Name="{DynamicResource String.TableKit.OutputDataAutomationName}" />
              <Button Grid.Column="2"
                      Command="{CompiledBinding BrowseOutputDataCommand}"
                      Classes="secondary compact-action"
                      AutomationProperties.Name="{DynamicResource String.TableKit.BrowseDataDirectory}">
                <PathIcon Data="{StaticResource Icon.Folder}" Width="13" Height="13" />
              </Button>
              <TextBlock Grid.Row="1" Text="{DynamicResource String.TableKit.OutputCodeDir}" Classes="muted" VerticalAlignment="Center" />
              <TextBox x:Name="TableKitOutputCodeDir"
                       Grid.Row="1"
                       Grid.Column="1"
                       Text="{CompiledBinding OutputCodeDir, Mode=TwoWay}"
                       IsReadOnly="True"
                       ToolTip.Tip="{CompiledBinding OutputCodeDir}"
                       AutomationProperties.Name="{DynamicResource String.TableKit.OutputCodeAutomationName}" />
              <Button Grid.Row="1"
                      Grid.Column="2"
                      Command="{CompiledBinding BrowseOutputCodeCommand}"
                      Classes="secondary compact-action"
                      AutomationProperties.Name="{DynamicResource String.TableKit.BrowseCodeDirectory}">
                <PathIcon Data="{StaticResource Icon.Folder}" Width="13" Height="13" />
              </Button>
            </Grid>
          </StackPanel>
        </Border>

        <Border x:Name="TableKitExtraOutputCard"
                Grid.Row="2"
                Classes="tablekit-extra-output-card">
          <Grid RowDefinitions="Auto,*" RowSpacing="10">
            <Grid ColumnDefinitions="3,*,Auto" ColumnSpacing="9">
              <Border Classes="tablekit-section-accent" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{DynamicResource String.TableKit.ExtraTargets}" Classes="section-title" />
                <TextBlock Text="{DynamicResource String.TableKit.ExtraTargetsHint}" Classes="tablekit-hint" />
              </StackPanel>
              <Button Grid.Column="2"
                      Command="{CompiledBinding AddExtraOutputCommand}"
                      Classes="secondary compact-action"
                       AutomationProperties.Name="{DynamicResource String.TableKit.AddExtraTargetAutomationName}">
                <TextBlock Text="{DynamicResource String.TableKit.AddExtraTarget}" />
              </Button>
            </Grid>
            <ScrollViewer x:Name="TableKitExtraOutputScroll"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource String.TableKit.NoExtraTargets}"
                           Classes="tablekit-hint"
                           IsVisible="{CompiledBinding !HasExtraOutputTargets}" />
                <ItemsControl ItemsSource="{CompiledBinding ExtraOutputTargets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TableKitExtraOutputViewModel">
                      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="6">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Target" Classes="tablekit-label" />
                            <ComboBox ItemsSource="{CompiledBinding TargetOptions}"
                                      SelectedItem="{CompiledBinding TargetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Code target" Classes="tablekit-label" />
                            <ComboBox ItemsSource="{CompiledBinding CodeTargetOptions}"
                                      SelectedItem="{CompiledBinding CodeTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Data target" Classes="tablekit-label" />
                            <ComboBox ItemsSource="{CompiledBinding DataTargetOptions}"
                                      SelectedItem="{CompiledBinding DataTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" />
                          </StackPanel>
                          <Button Grid.Column="3"
                                  Command="{CompiledBinding RemoveCommand}"
                                  Classes="ghost icon"
                                  VerticalAlignment="Bottom"
                                  ToolTip.Tip="{DynamicResource String.TableKit.RemoveTarget}"
                                   AutomationProperties.Name="{DynamicResource String.TableKit.RemoveTargetAutomationName}">
                            <PathIcon Data="{StaticResource Icon.Trash2}" Width="14" Height="14" />
                          </Button>
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="92,*,Auto" ColumnSpacing="6">
                          <TextBlock Text="{DynamicResource String.TableKit.OutputDataDir}" Classes="muted" VerticalAlignment="Center" />
                          <TextBox Grid.Column="1"
                                   Text="{CompiledBinding OutputDataDir, Mode=TwoWay}"
                                   IsReadOnly="True"
                                   ToolTip.Tip="{CompiledBinding OutputDataDir}" />
                          <Button Grid.Column="2"
                                  Command="{CompiledBinding BrowseDataCommand}"
                                  Classes="secondary compact-action"
                                   ToolTip.Tip="{DynamicResource String.TableKit.BrowseDataDirectory}"
                                   AutomationProperties.Name="{DynamicResource String.TableKit.BrowseDataDirectory}">
                            <PathIcon Data="{StaticResource Icon.Folder}" Width="13" Height="13" />
                          </Button>
                        </Grid>
                        <Grid Grid.Row="2" ColumnDefinitions="92,*,Auto" ColumnSpacing="6">
                          <TextBlock Text="{DynamicResource String.TableKit.OutputCodeDir}" Classes="muted" VerticalAlignment="Center" />
                          <TextBox Grid.Column="1"
                                   Text="{CompiledBinding OutputCodeDir, Mode=TwoWay}"
                                   IsReadOnly="True"
                                   ToolTip.Tip="{CompiledBinding OutputCodeDir}" />
                          <Button Grid.Column="2"
                                  Command="{CompiledBinding BrowseCodeCommand}"
                                  Classes="secondary compact-action"
                                   ToolTip.Tip="{DynamicResource String.TableKit.BrowseCodeDirectory}"
                                   AutomationProperties.Name="{DynamicResource String.TableKit.BrowseCodeDirectory}">
                            <PathIcon Data="{StaticResource Icon.Folder}" Width="13" Height="13" />
                          </Button>
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border x:Name="TableKitRightPane"
            Grid.Column="2"
            Classes="tablekit-config-pane">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Border Classes="tablekit-config-section">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="3,*" ColumnSpacing="9">
              <Border Classes="tablekit-section-accent" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{DynamicResource String.TableKit.RuntimePath}" Classes="section-title" />
                <TextBlock Text="{DynamicResource String.TableKit.RuntimePathHint}" Classes="tablekit-hint" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="104,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
              <TextBlock Text="{DynamicResource String.TableKit.ResourceAddressable}" Classes="muted" VerticalAlignment="Center" />
              <ToggleSwitch x:Name="TableKitAddressableToggle"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Left"
                            Classes="logkit-editor"
                            OnContent="{DynamicResource String.LogKit.On}"
                            OffContent="{DynamicResource String.LogKit.Off}"
                            IsChecked="{CompiledBinding IsAddressable, Mode=TwoWay}"
                            AutomationProperties.AutomationId="tablekit.location.addressable" />
              <Grid x:Name="TableKitRuntimePathRow"
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    ColumnDefinitions="104,*,Auto"
                    IsVisible="{CompiledBinding IsRuntimePathVisible}">
                <TextBlock Text="{DynamicResource String.TableKit.RuntimePathPattern}" Classes="muted" VerticalAlignment="Center" />
                <TextBox x:Name="TableKitRuntimePathPattern"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Text="{CompiledBinding RuntimePathPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Art/Table/{0}" />
              </Grid>
              <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="104,*">
                <TextBlock Text="{DynamicResource String.TableKit.LocationPreview}" Classes="muted" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{CompiledBinding RuntimeLocationPreview}"
                           Classes="mono tablekit-hint"
                           TextWrapping="Wrap" />
              </Grid>
              <TextBlock Grid.Row="3" Text="{DynamicResource String.TableKit.EditorDataPath}" Classes="muted" VerticalAlignment="Center" />
              <TextBox Grid.Row="3"
                       Grid.Column="1"
                       Text="{CompiledBinding EditorDataPath, Mode=TwoWay}"
                       IsReadOnly="True"
                       IsEnabled="{CompiledBinding CustomEditorDataPath}" />
              <Button Grid.Row="3"
                      Grid.Column="2"
                      Command="{CompiledBinding BrowseEditorDataCommand}"
                      Classes="secondary compact-action"
                      IsEnabled="{CompiledBinding CustomEditorDataPath}"
                       AutomationProperties.Name="{DynamicResource String.TableKit.BrowseEditorDataDirectory}">
                <PathIcon Data="{StaticResource Icon.Folder}" Width="13" Height="13" />
              </Button>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" MinHeight="34">
              <TextBlock Text="{DynamicResource String.TableKit.CustomEditorPath}" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1"
                            Classes="logkit-editor"
                            OnContent="{DynamicResource String.LogKit.On}"
                            OffContent="{DynamicResource String.LogKit.Off}"
                            IsChecked="{CompiledBinding CustomEditorDataPath, Mode=TwoWay}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="tablekit-config-section last">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="3,*" ColumnSpacing="9">
              <Border Classes="tablekit-section-accent" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{DynamicResource String.TableKit.AdvancedOptions}" Classes="section-title" />
                <TextBlock Text="{DynamicResource String.TableKit.AdvancedOptionsHint}" Classes="tablekit-hint" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto" RowSpacing="5">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinHeight="34">
                <TextBlock Text="{DynamicResource String.TableKit.UseAsmdef}" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" Classes="logkit-editor" OnContent="{DynamicResource String.LogKit.On}" OffContent="{DynamicResource String.LogKit.Off}" IsChecked="{CompiledBinding UseAssemblyDefinition, Mode=TwoWay}" />
              </Grid>
              <Grid Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" MinHeight="34">
                <TextBlock Text="{DynamicResource String.TableKit.ExternalTypeUtil}" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" Classes="logkit-editor" OnContent="{DynamicResource String.LogKit.On}" OffContent="{DynamicResource String.LogKit.Off}" IsChecked="{CompiledBinding GenerateExternalTypeUtil, Mode=TwoWay}" />
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" MinHeight="34">
                <TextBlock Text="{DynamicResource String.TableKit.RawResourceLoading}" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" Classes="logkit-editor" OnContent="{DynamicResource String.LogKit.On}" OffContent="{DynamicResource String.LogKit.Off}" IsChecked="{CompiledBinding UseRawResourceLoading, Mode=TwoWay}" />
              </Grid>
            </Grid>
            <Grid ColumnDefinitions="92,*">
              <TextBlock Text="{DynamicResource String.TableKit.AssemblyName}" Classes="muted" VerticalAlignment="Center" />
              <TextBox Grid.Column="1"
                       Text="{CompiledBinding AssemblyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
