<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Workbench 工具链共享的 Runtime 缓存契约与校验原语。
    源文件保持单一物理位置：Shared/RuntimeCache 由工具链独占；
    Core/Editor/CommandBridge/Storage（协议证据清理）与 Core/Editor/Tooling/RuntimeCache 同时被
    Packaging 与 Installer.Core 使用——统一经本程序集链接编译，消除此前多工程重复编译导致的类型身份分裂。
    Pruner 三文件已随 Player 剔除整改迁入 Core/Editor，需 YOKIFRAME_TOOLING 宏激活其编译。
    以下目录全部源文件都有 YOKIFRAME_TOOLING 守卫，或本身就是工具链独占文件。
    使用目录通配后，同目录新增或改名不再需要同步逐文件链接。
  -->
  <ItemGroup>
    <Compile Include="..\..\..\Core\Editor\RuntimeCache\**\*.cs" Link="RuntimeCache\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- 共享只读 JSON DOM（替代 System.Text.Json）位于 CommandBridge\Json，RuntimeCache 校验器与 EngineKit 共用。 -->
    <Compile Include="..\..\..\Core\Editor\CommandBridge\Json\**\*.cs" Link="Json\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Shared\RuntimeCache\**\*.cs" Link="RuntimeCache\Shared\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\..\Core\Editor\CommandBridge\Storage\**\*.cs" Link="Storage\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\..\Core\Editor\Tooling\RuntimeCache\**\*.cs" Link="RuntimeCacheLayout\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- FileBridge 布局常量保持单一物理事实源：由 YokiFrame.Protocol 链接编译，本程序集经引用消费。 -->
    <ProjectReference Include="..\YokiFrame.Protocol\YokiFrame.Protocol.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);YOKIFRAME_TOOLING</DefineConstants>
  </PropertyGroup>

</Project>
